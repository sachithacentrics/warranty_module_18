<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amc_contract_visit_view_form" model="ir.ui.view">
        <field name="name">amc.contract.visit.view.form.inherit.amc_management_service</field>
        <field name="model">amc.contract.visit</field>
        <field name="inherit_id" ref="amc_management.amc_contract_visit_view_form"/>
        <field name="arch" type="xml">
            <!-- AMC-F01: consumption only through the Service Job; requests from here. -->
            <xpath expr="//button[@name='action_open_complete_wizard']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_service_request" type="object" string="Create Service Request"
                        class="btn-primary" invisible="state != 'pending' or contract_state not in ('active', 'expiring')"
                        groups="amc_management.group_amc_coordinator"/>
            </xpath>
            <xpath expr="//field[@name='consumption_source']" position="after">
                <field name="warranty_case_id" invisible="not warranty_case_id"/>
                <field name="helpdesk_ticket_id" invisible="not helpdesk_ticket_id"/>
                <field name="service_job_id" invisible="not service_job_id"/>
                <field name="task_id" invisible="not task_id"/>
                <field name="worksheet_id" invisible="not worksheet_id"/>
            </xpath>
        </field>
    </record>

    <record id="amc_contract_visit_view_list" model="ir.ui.view">
        <field name="name">amc.contract.visit.view.list.inherit.amc_management_service</field>
        <field name="model">amc.contract.visit</field>
        <field name="inherit_id" ref="amc_management.amc_contract_visit_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_open_service_request" type="object"
                            string="Create Service Request"
                            groups="amc_management.group_amc_coordinator"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='completion_date']" position="after">
                <field name="helpdesk_ticket_id" optional="show"/>
                <field name="service_job_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="amc_contract_visit_view_search" model="ir.ui.view">
        <field name="name">amc.contract.visit.view.search.inherit.amc_management_service</field>
        <field name="model">amc.contract.visit</field>
        <field name="inherit_id" ref="amc_management.amc_contract_visit_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='serial_id']" position="after">
                <field name="helpdesk_ticket_id"/>
                <field name="service_job_id"/>
            </xpath>
        </field>
    </record>

    <record id="amc_service_request_wizard_view_form" model="ir.ui.view">
        <field name="name">amc.service.request.wizard.form</field>
        <field name="model">amc.service.request.wizard</field>
        <field name="arch" type="xml">
            <form string="AMC Service Request">
                <div class="alert alert-warning" role="alert" invisible="not problems">
                    <field name="problems" nolabel="1"/>
                </div>
                <group>
                    <group>
                        <field name="contract_id"/>
                        <field name="partner_id"/>
                        <field name="site_id"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="ticket_mode" widget="radio"/>
                        <field name="team_id" invisible="ticket_mode != 'new'"
                               options="{'no_create': True}"/>
                        <field name="ticket_id" invisible="ticket_mode != 'link'"
                               required="ticket_mode == 'link'" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="visit_ids">
                    <list>
                        <field name="name"/>
                        <field name="label"/>
                        <field name="product_id"/>
                        <field name="serial_id"/>
                        <field name="due_date"/>
                        <field name="state"/>
                    </list>
                </field>
                <field name="description" placeholder="Additional request / ad-hoc complaint"/>
                <footer>
                    <button name="action_confirm" type="object" string="Create Service Request"
                            class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
