<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_service_job_view_list" model="ir.ui.view">
        <field name="name">warranty.service.job.list</field>
        <field name="model">warranty.service.job</field>
        <field name="arch" type="xml">
            <list string="Service Jobs" create="0">
                <!-- Phase 4.9 (approved B1 / B2). -->
                <header>
                    <button name="action_open_batch_wizard" type="object"
                            string="Complete Selected Jobs" groups="helpdesk.group_helpdesk_user"/>
                </header>
                <field name="name"/>
                <field name="warranty_case_id"/>
                <field name="helpdesk_ticket_id" optional="show"/>
                <field name="partner_id"/>
                <field name="site_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="merge_type" optional="show"/>
                <field name="planned_date" optional="show"/>
                <field name="main_technician_id" optional="show" widget="many2one_avatar_user"/>
                <field name="completion_mode" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'planned')"
                       decoration-warning="state in ('awaiting_parts', 'workshop')"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="warranty_service_job_view_form" model="ir.ui.view">
        <field name="name">warranty.service.job.form</field>
        <field name="model">warranty.service.job</field>
        <field name="arch" type="xml">
            <form string="Service Job" create="0">
                <header>
                    <button name="action_confirm_job" type="object" string="Confirm Service Job"
                            class="btn-primary" groups="helpdesk.group_helpdesk_user"
                            invisible="state != 'planned'"/>
                    <button name="action_prepare_for_confirmation" type="object"
                            string="Plan Job" class="btn-primary"
                            groups="helpdesk.group_helpdesk_user" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="helpdesk.group_helpdesk_user"
                            invisible="state not in ('draft', 'planned')"
                            confirm="Cancel this service job? The warranty case stays Approved and the free services are released."/>
                    <button name="action_open_hold_wizard" type="object" string="Awaiting Parts"
                            context="{'warranty_hold_action': 'awaiting_parts'}"
                            groups="helpdesk.group_helpdesk_user,industry_fsm.group_fsm_user"
                            invisible="state != 'in_progress'"/>
                    <button name="action_open_hold_wizard" type="object" string="Workshop Repair"
                            context="{'warranty_hold_action': 'workshop'}"
                            groups="helpdesk.group_helpdesk_user,industry_fsm.group_fsm_user"
                            invisible="state != 'in_progress'"/>
                    <button name="action_open_hold_wizard" type="object" string="Resume Job"
                            class="btn-primary" context="{'warranty_hold_action': 'resume'}"
                            groups="helpdesk.group_helpdesk_user,industry_fsm.group_fsm_user"
                            invisible="state not in ('awaiting_parts', 'workshop')"/>
                    <!-- Phase 4.8 (approved L3 / L6 / L7 / L9): Helpdesk users. -->
                    <button name="action_open_plan_wizard" type="object" string="Plan Next Visit"
                            class="btn-primary" groups="helpdesk.group_helpdesk_user"
                            invisible="state != 'incomplete'"/>
                    <!-- UX next step: the visit is where a confirmed job is carried out. -->
                    <button name="action_open_current_visit" type="object" string="Open Field Service"
                            class="btn-primary" invisible="not visit_count or state not in ('confirmed', 'rescheduled', 'in_progress')"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel Job"
                            groups="helpdesk.group_helpdesk_user"
                            invisible="state not in ('confirmed', 'in_progress', 'awaiting_parts', 'workshop', 'incomplete', 'rescheduled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_warranty_history" type="object"
                                class="oe_stat_button" icon="fa-history" string="Warranty History"
                                invisible="not warranty_card_ids"/>
                        <button name="action_view_visits" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not visit_count">
                            <field name="visit_count" widget="statinfo" string="Field Service"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="warranty_case_id"/>
                            <field name="helpdesk_ticket_id"/>
                            <field name="partner_id"/>
                            <field name="site_id" invisible="1"/>
                            <field name="warranty_site_address" invisible="not warranty_site_address"/>
                        </group>
                        <group name="right">
                            <field name="product_id" invisible="merge_type == 'merged'"/>
                            <field name="serial_id" invisible="merge_type == 'merged'"/>
                            <field name="warranty_card_id" invisible="merge_type == 'merged'"/>
                            <field name="warranty_card_ids" widget="many2many_tags"
                                   invisible="(warranty_card_id and merge_type != 'merged') or not warranty_card_ids"/>
                            <field name="warranty_unit_id" invisible="merge_type == 'merged'"/>
                            <field name="merge_type" invisible="merge_type == 'none'"/>
                            <field name="completion_mode"
                                   readonly="state in ('completed', 'cancelled')"/>
                            <field name="reschedule_count" invisible="not reschedule_count"/>
                            <field name="cancel_reason" invisible="not cancel_reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Planning" name="planning">
                        <group>
                            <field name="technician_candidate_ids" invisible="1"/>
                            <field name="planned_date" readonly="state not in ('draft', 'planned')"
                                   required="state == 'planned'"/>
                            <field name="main_technician_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"
                                   readonly="state not in ('draft', 'planned')"
                                   required="state == 'planned'"/>
                        </group>
                        <group>
                            <field name="support_technician_ids" widget="many2many_avatar_user"
                                   options="{'no_create': True}"
                                   readonly="state not in ('draft', 'planned')"/>
                        </group>
                    </group>
                    <notebook name="notebook">
                        <!-- Phase 4.8 (approved L10): visit attempt history. -->
                        <page string="Visits" name="visits" invisible="not visit_ids"
                              groups="industry_fsm.group_fsm_user,project.group_project_user">
                            <field name="visit_ids">
                                <list create="0" delete="0" decoration-muted="state == '1_canceled'">
                                    <field name="warranty_visit_no" string="Visit"/>
                                    <field name="name"/>
                                    <field name="planned_date_begin" string="Planned"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == '1_canceled'"
                                           decoration-success="state == '1_done'"
                                           decoration-info="state not in ('1_done', '1_canceled')"/>
                                    <field name="warranty_visit_outcome"/>
                                    <field name="warranty_noncompletion_reason" optional="show"/>
                                    <field name="priority" widget="priority" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Worksheets" name="worksheets" invisible="not worksheet_ids">
                            <field name="worksheet_ids">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="entitlement_id" optional="show"/>
                                    <field name="warranty_card_id" optional="show"/>
                                    <field name="product_id"/>
                                    <field name="unit_id" optional="show"/>
                                    <field name="serial_display" optional="show"/>
                                    <field name="template_id"/>
                                    <field name="usage_required" optional="show"/>
                                    <field name="current_usage" optional="show"/>
                                    <field name="usage_unit" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'todo'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-success="state == 'completed'"/>
                                    <button name="action_open_worksheet" type="object" string="Open Worksheet"
                                            icon="fa-pencil" invisible="not template_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Free Services" name="free_services"
                              invisible="not entitlement_ids and state not in ('draft', 'planned')">
                            <field name="entitlement_ids" context="{'warranty_service_job_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="service_no"/>
                                    <field name="warranty_card_id"/>
                                    <field name="warranty_job_product_display"/>
                                    <field name="warranty_job_unit_display"/>
                                    <field name="warranty_job_serial_display"/>
                                    <field name="due_date"/>
                                    <field name="grace_period_end_date" optional="hide"/>
                                    <field name="earliest_service_date" optional="hide"/>
                                    <field name="latest_service_date" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                    <field name="merge_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_service_job_view_search" model="ir.ui.view">
        <field name="name">warranty.service.job.search</field>
        <field name="model">warranty.service.job</field>
        <field name="arch" type="xml">
            <search string="Service Jobs">
                <field name="name"/>
                <field name="warranty_case_id"/>
                <field name="helpdesk_ticket_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <field name="warranty_card_id"/>
                <field name="main_technician_id"/>
                <filter name="filter_open" string="Open" domain="[('state', 'not in', ('completed', 'cancelled'))]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_main_technician" string="Main Technician" context="{'group_by': 'main_technician_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_service_job" model="ir.actions.act_window">
        <field name="name">Service Jobs</field>
        <field name="res_model">warranty.service.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No service job yet</p>
            <p>Service Jobs are prepared from approved warranty cases (Prepare Service Job).</p>
        </field>
    </record>

    <!-- Warranty Case: Prepare Service Job + smart button (Phase 4.1). -->
    <record id="warranty_case_view_form_fsm" model="ir.ui.view">
        <field name="name">warranty.case.form.fsm</field>
        <field name="model">warranty.case</field>
        <field name="inherit_id" ref="warranty_management_helpdesk.warranty_case_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_check_eligibility']" position="after">
                <field name="open_service_job_id" invisible="1"/>
                <button name="action_prepare_service_job" type="object" string="Prepare Service Job"
                        class="btn-primary" groups="helpdesk.group_helpdesk_user"
                        invisible="state != 'approved' or eligibility_result != 'eligible' or open_service_job_id"/>
                <!-- UX (Figure 9 UAT, WCAS/000072): Inspection Required runs the inspection
                     quotation first; the button names that step. Same method, same checks. -->
                <field name="warranty_inspection_step" invisible="1"/>
                <button name="action_prepare_service_job" type="object"
                        string="Create Inspection Quotation" class="btn-primary"
                        groups="helpdesk.group_helpdesk_user"
                        invisible="warranty_inspection_step != 'quotation'"/>
                <button name="action_open_inspection_quotation" type="object"
                        string="Open Inspection Quotation" class="btn-primary"
                        groups="helpdesk.group_helpdesk_user"
                        invisible="warranty_inspection_step != 'waiting'"/>
                <button name="action_open_service_job" type="object" string="Open Service Job"
                        class="btn-primary" invisible="not open_service_job_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_service_jobs" type="object" class="oe_stat_button"
                        icon="fa-briefcase" invisible="not service_job_count">
                    <field name="service_job_count" widget="statinfo" string="Service Jobs"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Free service: its open Service Job. -->
    <record id="warranty_service_entitlement_view_form_fsm" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.form.fsm</field>
        <field name="model">warranty.service.entitlement</field>
        <field name="inherit_id" ref="warranty_management.warranty_service_entitlement_view_form"/>
        <field name="arch" type="xml">
            <field name="merge_status" position="after">
                <field name="open_service_job_id" invisible="not open_service_job_id"/>
            </field>
        </field>
    </record>
    <record id="warranty_case_view_form_repeat_job" model="ir.ui.view">
        <field name="name">warranty.case.form.repeat.job</field>
        <field name="model">warranty.case</field>
        <field name="inherit_id" ref="warranty_management_helpdesk.warranty_case_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='repeat_of_case_id']" position="after">
                <field name="repeat_of_job_id" invisible="case_type != 'repeat_complaint' or not repeat_of_case_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
