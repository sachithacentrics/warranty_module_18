<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approved shared-worksheet fix: worksheet templates hosted on the worksheet instance. -->
    <record id="action_warranty_worksheet_template" model="ir.actions.act_window">
        <field name="name">Warranty Worksheet Templates</field>
        <field name="res_model">worksheet.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('res_model', '=', 'warranty.job.worksheet')]</field>
        <field name="context">{'default_res_model': 'warranty.job.worksheet'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Warranty Worksheet template</p>
            <p>One checklist per worksheet instance: merged services of one visit keep their own
                answers, also with the same template. Design it with Studio.</p>
        </field>
    </record>
    <menuitem id="menu_warranty_worksheet_template" name="Warranty Worksheet Templates"
              parent="warranty_management.menu_warranty_configuration"
              action="action_warranty_worksheet_template" sequence="60"
              groups="helpdesk.group_helpdesk_manager"/>
</odoo>
