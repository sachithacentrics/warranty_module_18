<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="warranty_service_job_company_rule" model="ir.rule">
            <field name="name">Warranty Service Job: multi-company</field>
            <field name="model_id" ref="model_warranty_service_job"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_job_worksheet_company_rule" model="ir.rule">
            <field name="name">Service Job Worksheet: multi-company</field>
            <field name="model_id" ref="model_warranty_job_worksheet"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
    <!-- Warranty Worksheet templates (hosted on the worksheet instance): the standard
         "Worksheet Template: Project Only" rule gives Project users the task-hosted templates
         only; as the Maintenance / Quality worksheets, these rules add the warranty-hosted
         ones (group rules are combined with OR). The standard rules and the worksheet
         multi-company rule are unchanged. Updatable (not noupdate) so corrections apply. -->
    <data>
        <!-- First version of 2026-10-23 (warranty_test only), replaced by the rules below. -->
        <delete model="ir.rule" search="[('model_id.model', '=', 'worksheet.template'), ('name', 'in', ['Worksheet Template: Warranty Worksheet', 'Worksheet Template: Warranty Worksheet (Helpdesk managers)'])]"/>
        <!-- Read: Project / Field Service and Helpdesk users (templates of their work). -->
        <record id="ir_rule_warranty_worksheet_template_read" model="ir.rule">
            <field name="name">Warranty Worksheet Templates: read</field>
            <field name="model_id" ref="worksheet.model_worksheet_template"/>
            <field name="groups" eval="[(4, ref('project.group_project_user')), (4, ref('helpdesk.group_helpdesk_user'))]"/>
            <field name="domain_force">[('res_model', '=', 'warranty.job.worksheet')]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Manage: Helpdesk managers only (Project managers keep the task templates only).
             Creating / deleting a template also generates / removes its model: standard Odoo
             requires the Administration / Access Rights group for that. -->
        <record id="ir_rule_warranty_worksheet_template_manager" model="ir.rule">
            <field name="name">Warranty Worksheet Templates: Helpdesk managers</field>
            <field name="model_id" ref="worksheet.model_worksheet_template"/>
            <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_manager'))]"/>
            <field name="domain_force">[('res_model', '=', 'warranty.job.worksheet')]</field>
        </record>
    </data>
</odoo>
