<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- A clickable count: opens the records it counts; "—" without access. -->
    <t t-name="warranty_management_dashboard.Num">
        <span t-if="value === null or value === undefined" class="o_wd_num o_wd_na" title="No access">—</span>
        <span t-else="" class="o_wd_num" t-att-class="extraClass or ''" role="button" tabindex="0"
              t-att-aria-label="label + ': ' + value"
              t-on-click="() => this.open(figure, extra or {})"
              t-on-keydown="(ev) => this.onKey(ev, figure, extra or {})" t-esc="value"/>
    </t>

    <!-- Card header: title and icon chip. -->
    <t t-name="warranty_management_dashboard.CardHead">
        <div class="o_wd_card_head">
            <h2 t-esc="title"/>
            <span class="o_wd_chip"><i t-attf-class="fa {{ icon }}" aria-hidden="true"/></span>
        </div>
    </t>

    <t t-name="warranty_management_dashboard.Dashboard">
        <!-- Odoo's action layout: the action root does not scroll (overflow hidden); its
             .o_content child does on desktop, the action itself on mobile. -->
        <div class="o_action o_warranty_dashboard">
          <div class="o_content o_wd_content">
            <div class="o_wd_header">
                <div>
                    <h1 class="o_wd_title">Warranty Dashboard</h1>
                    <div class="o_wd_subtitle">Warranty status, pending services, approvals, replacements and escalations</div>
                </div>
                <div class="o_wd_header_actions">
                    <button class="btn btn-secondary" t-on-click="resetFilters" title="Reset filters">
                        <i class="fa fa-undo"/><span class="d-none d-md-inline ms-1">Reset</span>
                    </button>
                    <button class="btn btn-primary o_wd_refresh" t-on-click="() => this.load()" title="Reload all figures">
                        <i class="fa fa-refresh"/><span class="d-none d-md-inline ms-1">Refresh</span>
                    </button>
                </div>
            </div>

            <t t-if="state.data">
                <t t-set="d" t-value="state.data"/>
                <t t-set="options" t-value="d.options"/>
                <t t-set="f" t-value="state.filters"/>
                <t t-set="w" t-value="d.warranty"/>
                <!-- ======================================================= filters -->
                <section class="o_wd_panel o_wd_filter_panel">
                    <div class="o_wd_panel_title">
                        <span>Filter Dashboard</span>
                        <small t-if="d.period">Period figures · Card Status applies to Warranty Status only</small>
                        <small t-else="">Today's position · Card Status applies to Warranty Status only</small>
                    </div>
                    <div class="o_wd_filters">
                        <label class="o_wd_field" t-att-class="{'o_wd_field_fixed': options.companies.length &lt; 2}">
                            <span>Company</span>
                            <select t-if="options.companies.length > 1" t-on-change="(ev) => this.onFilter('company_id', ev)">
                                <option value="" t-att-selected="!f.company_id">All allowed companies</option>
                                <t t-foreach="options.companies" t-as="c" t-key="c.id">
                                    <option t-att-value="c.id" t-att-selected="f.company_id === c.id" t-esc="c.name"/>
                                </t>
                            </select>
                            <select t-else="" disabled="disabled" title="Select more companies in the company switcher to compare them">
                                <option t-esc="companyName"/>
                            </select>
                        </label>
                        <label class="o_wd_field" t-att-class="{'o_wd_field_fixed': !options.branches.length}">
                            <span>Branch</span>
                            <select t-if="options.branches.length" t-on-change="(ev) => this.onFilter('branch_id', ev)">
                                <option value="" t-att-selected="!f.branch_id">All branches</option>
                                <t t-foreach="options.branches" t-as="b" t-key="b.id">
                                    <option t-att-value="b.id" t-att-selected="f.branch_id === b.id" t-esc="b.name"/>
                                </t>
                            </select>
                            <select t-else="" disabled="disabled" title="The selected company has no branches">
                                <option>No branches</option>
                            </select>
                        </label>
                        <label class="o_wd_field">
                            <span>Product Category</span>
                            <select t-on-change="(ev) => this.onFilter('category_id', ev)">
                                <option value="" t-att-selected="!f.category_id">All categories</option>
                                <t t-foreach="options.categories" t-as="c" t-key="c.id">
                                    <option t-att-value="c.id" t-att-selected="f.category_id === c.id" t-esc="c.name"/>
                                </t>
                            </select>
                        </label>
                        <label class="o_wd_field">
                            <span>Card Status</span>
                            <select t-on-change="(ev) => this.onFilter('card_state', ev)">
                                <option value="" t-att-selected="!f.card_state">All statuses</option>
                                <t t-foreach="options.card_states" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-att-selected="f.card_state === s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </label>
                        <label class="o_wd_field">
                            <span>Date From</span>
                            <input type="date" t-att-value="f.date_from or ''" t-on-change="(ev) => this.onFilter('date_from', ev)"/>
                        </label>
                        <label class="o_wd_field">
                            <span>Date To</span>
                            <input type="date" t-att-value="f.date_to or ''" t-on-change="(ev) => this.onFilter('date_to', ev)"/>
                        </label>
                    </div>
                </section>

                <div t-att-class="{'o_wd_busy': state.loading}">
                    <!-- =================================================== row 1 -->
                    <div class="o_wd_row o_wd_row_3">
                        <section class="o_wd_card o_wd_area o_wd_purple">
                            <t t-call="warranty_management_dashboard.CardHead"><t t-set="title" t-value="'Warranty Status'"/><t t-set="icon" t-value="'fa-shield'"/></t>
                            <div class="o_wd_kpi">
                                <t t-call="warranty_management_dashboard.Num">
                                    <t t-set="value" t-value="w.active"/><t t-set="figure" t-value="'active'"/>
                                    <t t-set="label" t-value="'Active warranties'"/><t t-set="extraClass" t-value="'o_wd_big'"/>
                                </t>
                                <div class="o_wd_caption" t-esc="d.period ? 'Warranties in force in the period' : 'Active warranties today'"/>
                            </div>
                            <div class="o_wd_rows">
                                <div class="o_wd_row_line">
                                    <span t-if="d.period">Ending in the period</span>
                                    <span t-else="">Expiring within
                                        <select class="o_wd_inline_select" aria-label="Expiring window in days" t-on-change="(ev) => this.onFilter('expiring_days', ev)">
                                            <t t-foreach="options.expiring_windows" t-as="n" t-key="n">
                                                <option t-att-value="n" t-att-selected="f.expiring_days === n" t-esc="n"/>
                                            </t>
                                        </select> days</span>
                                    <t t-call="warranty_management_dashboard.Num">
                                        <t t-set="value" t-value="w.expiring"/><t t-set="figure" t-value="'expiring'"/><t t-set="label" t-value="'Expiring'"/>
                                    </t>
                                </div>
                                <div class="o_wd_hint">Status distribution: chart below</div>
                            </div>
                        </section>

                        <t t-set="s" t-value="d.services"/>
                        <section class="o_wd_card o_wd_area o_wd_teal">
                            <t t-call="warranty_management_dashboard.CardHead"><t t-set="title" t-value="'Pending Services'"/><t t-set="icon" t-value="'fa-clock-o'"/></t>
                            <div class="o_wd_kpi">
                                <t t-call="warranty_management_dashboard.Num">
                                    <t t-set="value" t-value="s.open"/><t t-set="figure" t-value="'pending_services'"/>
                                    <t t-set="label" t-value="'Open services'"/><t t-set="extraClass" t-value="'o_wd_big'"/>
                                </t>
                                <div class="o_wd_caption" t-esc="d.period ? 'Open services due in the period' : 'Open services'"/>
                            </div>
                            <div class="o_wd_rows">
                                <div class="o_wd_row_line">
                                    <span>Overdue</span>
                                    <t t-call="warranty_management_dashboard.Num">
                                        <t t-set="value" t-value="s.overdue"/><t t-set="figure" t-value="'services_overdue'"/>
                                        <t t-set="label" t-value="'Overdue'"/><t t-set="extraClass" t-value="'o_wd_text_coral'"/>
                                    </t>
                                </div>
                                <div class="o_wd_row_line">
                                    <span>Due / Upcoming</span>
                                    <span class="o_wd_pair">
                                        <t t-call="warranty_management_dashboard.Num">
                                            <t t-set="value" t-value="due('due')"/><t t-set="figure" t-value="'services_by_due'"/>
                                            <t t-set="extra" t-value="{due_status: 'due'}"/><t t-set="label" t-value="'Due'"/>
                                        </t>
                                        <span class="o_wd_sep">/</span>
                                        <t t-call="warranty_management_dashboard.Num">
                                            <t t-set="value" t-value="due('upcoming')"/><t t-set="figure" t-value="'services_by_due'"/>
                                            <t t-set="extra" t-value="{due_status: 'upcoming'}"/><t t-set="label" t-value="'Upcoming'"/>
                                        </t>
                                    </span>
                                </div>
                                <div class="o_wd_row_line">
                                    <span>Not yet in alert window</span>
                                    <t t-call="warranty_management_dashboard.Num">
                                        <t t-set="value" t-value="due('none')"/><t t-set="figure" t-value="'services_by_due'"/>
                                        <t t-set="extra" t-value="{due_status: false}"/><t t-set="label" t-value="'Not yet in alert window'"/>
                                    </t>
                                </div>
                            </div>
                        </section>

                        <t t-set="a" t-value="d.approvals"/>
                        <section class="o_wd_card o_wd_area o_wd_blue">
                            <t t-call="warranty_management_dashboard.CardHead"><t t-set="title" t-value="'Approvals'"/><t t-set="icon" t-value="'fa-check'"/></t>
                            <div class="o_wd_kpi">
                                <span class="o_wd_num o_wd_big o_wd_static" t-esc="a.total"/>
                                <div class="o_wd_caption">Waiting for approval</div>
                            </div>
                            <div class="o_wd_rows">
                                <t t-foreach="[['appr_case'], ['appr_mrf'], ['appr_replacement', 'appr_vendor_claim'], ['appr_card_action', 'appr_download'], ['appr_date_exception']]" t-as="group" t-key="group[0]">
                                    <t t-set="lines" t-value="group.map((key) => approval(key))"/>
                                    <div t-if="lines.some((line) => line)" class="o_wd_row_line">
                                        <span t-esc="lines.filter((line) => line).map((line) => shortLabel(line)).join(' / ')"/>
                                        <span class="o_wd_pair">
                                            <t t-foreach="lines.filter((line) => line)" t-as="line" t-key="line.key">
                                                <span t-if="!line_first" class="o_wd_sep">/</span>
                                                <t t-call="warranty_management_dashboard.Num">
                                                    <t t-set="value" t-value="line.count"/><t t-set="figure" t-value="line.key"/><t t-set="label" t-value="line.label"/>
                                                </t>
                                            </t>
                                        </span>
                                    </div>
                                </t>
                                <div t-if="!a.lines.length" class="o_wd_empty">No access.</div>
                            </div>
                        </section>
                    </div>

                    <!-- =================================================== row 2 -->
                    <div class="o_wd_row o_wd_row_2">
                        <t t-set="r" t-value="d.replacements"/>
                        <section class="o_wd_card o_wd_area o_wd_amber o_wd_left_border">
                            <t t-call="warranty_management_dashboard.CardHead"><t t-set="title" t-value="'Replacements'"/><t t-set="icon" t-value="'fa-exchange'"/></t>
                            <div class="o_wd_kpi">
                                <t t-call="warranty_management_dashboard.Num">
                                    <t t-set="value" t-value="r.open"/><t t-set="figure" t-value="'open_replacements'"/>
                                    <t t-set="label" t-value="'Open replacements'"/><t t-set="extraClass" t-value="'o_wd_big'"/>
                                </t>
                                <div class="o_wd_caption">Open replacements</div>
                            </div>
                            <div class="o_wd_rows">
                                <div class="o_wd_row_line">
                                    <span>Awaiting approval</span>
                                    <t t-call="warranty_management_dashboard.Num">
                                        <t t-set="value" t-value="r.submitted"/><t t-set="figure" t-value="'appr_replacement'"/><t t-set="label" t-value="'Awaiting approval'"/>
                                    </t>
                                </div>
                            </div>
                        </section>
                        <t t-set="e" t-value="d.escalations"/>
                        <section class="o_wd_card o_wd_area o_wd_coral o_wd_left_border">
                            <t t-call="warranty_management_dashboard.CardHead"><t t-set="title" t-value="'Escalations'"/><t t-set="icon" t-value="'fa-exclamation'"/></t>
                            <div class="o_wd_kpi">
                                <t t-call="warranty_management_dashboard.Num">
                                    <t t-set="value" t-value="e.pending"/><t t-set="figure" t-value="'escalations'"/>
                                    <t t-set="label" t-value="'Pending GM escalation'"/><t t-set="extraClass" t-value="'o_wd_big'"/>
                                </t>
                                <div class="o_wd_caption">Pending GM escalation</div>
                            </div>
                            <div class="o_wd_rows">
                                <div class="o_wd_row_line">
                                    <span>Open repeated-failure cases</span>
                                    <t t-call="warranty_management_dashboard.Num">
                                        <t t-set="value" t-value="e.repeated"/><t t-set="figure" t-value="'repeated_flagged'"/><t t-set="label" t-value="'Open repeated-failure cases'"/>
                                    </t>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- =================================================== chart -->
                    <section class="o_wd_card o_wd_chart_panel">
                        <div class="o_wd_card_head o_wd_chart_head">
                            <div>
                                <h2>Warranty Cards by Status</h2>
                                <div class="o_wd_caption" t-esc="d.period ? 'Warranty cards created in the period, by status' : 'Breakdown of the existing warranty cards by status'"/>
                            </div>
                        </div>
                        <div t-if="w.by_status and w.by_status.length" class="o_wd_bars" role="list">
                            <t t-foreach="w.by_status" t-as="line" t-key="line.key">
                                <div class="o_wd_bar_row" role="button" tabindex="0" t-att-data-state="line.key"
                                     t-att-aria-label="line.label + ': ' + line.value"
                                     t-on-click="() => this.open('card_status', line.extra)"
                                     t-on-keydown="(ev) => this.onKey(ev, 'card_status', line.extra)">
                                    <span class="o_wd_bar_label" t-esc="line.label"/>
                                    <span class="o_wd_bar_track"><span t-attf-class="o_wd_bar_fill o_wd_state_{{ line.key }}" t-att-style="barWidth(line.value)"/></span>
                                    <span class="o_wd_bar_value" t-esc="line.value"/>
                                </div>
                            </t>
                        </div>
                        <div t-elif="!w.by_status" class="o_wd_empty">Warranty cards are not available for your access rights.</div>
                        <div t-else="" class="o_wd_empty">No warranty card matches the filters.</div>
                    </section>

                    <!-- =================================================== reports -->
                    <section t-if="d.reports.length" class="o_wd_card o_wd_reports_panel">
                        <h2>Reports &amp; Quick Access</h2>
                        <div class="o_wd_caption">Open the existing warranty reports and lists</div>
                        <div class="o_wd_links">
                            <t t-foreach="d.reports" t-as="report" t-key="report.xml_id">
                                <button class="o_wd_link" t-on-click="() => this.openReport(report)">
                                    <span t-esc="report.name"/><i class="fa fa-external-link ms-2" aria-hidden="true"/>
                                </button>
                            </t>
                        </div>
                    </section>
                </div>
            </t>
            <div t-else="" class="o_wd_empty o_wd_loading"><i class="fa fa-circle-o-notch fa-spin me-2"/>Loading the dashboard…</div>
          </div>
        </div>
    </t>
</templates>
