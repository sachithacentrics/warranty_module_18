<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Warranty Management > Dashboard": first entry of the Warranty app, so it is the
         page that opens with the app; the other menus are unchanged. -->
    <record id="action_warranty_dashboard" model="ir.actions.client">
        <field name="name">Warranty Dashboard</field>
        <field name="tag">warranty_management_dashboard.dashboard</field>
    </record>

    <menuitem id="menu_warranty_dashboard" name="Dashboard"
              parent="warranty_management.menu_warranty_root"
              action="action_warranty_dashboard" sequence="1"/>
</odoo>
