<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_warranty_role" model="ir.ui.view">
        <field name="name">mrp.bom.form.warranty.role</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']" position="after">
                <field name="warranty_component_role" column_invisible="parent.type != 'phantom'"/>
            </xpath>
        </field>
    </record>
</odoo>
