<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amc_billing_plan_view_list" model="ir.ui.view">
        <field name="name">amc.billing.plan.list</field>
        <field name="model">amc.billing.plan</field>
        <field name="arch" type="xml">
            <list string="Billing Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="billing_frequency"/>
                <field name="billing_timing"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="amc_billing_plan_view_form" model="ir.ui.view">
        <field name="name">amc.billing.plan.form</field>
        <field name="model">amc.billing.plan</field>
        <field name="arch" type="xml">
            <form string="Billing Plan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Quarterly in Advance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="billing_frequency"/>
                            <field name="billing_timing"
                                   readonly="billing_frequency in ('upfront', 'per_visit')"
                                   force_save="1"/>
                            <field name="interval_months"
                                   invisible="billing_frequency in ('upfront', 'per_visit')"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="When and how the contract value is invoiced"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_amc_billing_plan" model="ir.actions.act_window">
        <field name="name">Billing Plans</field>
        <field name="res_model">amc.billing.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
