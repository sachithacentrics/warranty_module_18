<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="amc_pricing_formula_view_list" model="ir.ui.view">
        <field name="name">amc.pricing.formula.list</field>
        <field name="model">amc.pricing.formula</field>
        <field name="arch" type="xml">
            <list string="Pricing Formulas" decoration-muted="state == 'archived'"
                  decoration-info="state == 'draft'">
                <field name="plan_id"/>
                <field name="version"/>
                <field name="method"/>
                <field name="currency_id"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="is_current" string="In Force"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="amc_pricing_formula_view_form" model="ir.ui.view">
        <field name="name">amc.pricing.formula.form</field>
        <field name="model">amc.pricing.formula</field>
        <field name="arch" type="xml">
            <form string="Pricing Formula">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'" groups="amc_management.group_amc_manager"
                            confirm="An Active version cannot be changed any more. Activate?"/>
                    <button name="action_new_version" type="object" string="New Version"
                            invisible="state == 'draft'" groups="amc_management.group_amc_manager"/>
                    <button name="action_archive_version" type="object" string="Archive"
                            invisible="state != 'active'" groups="amc_management.group_amc_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="state != 'draft' or id"
                                   options="{'no_create': True}"/>
                            <field name="method" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="effective_from" readonly="state != 'draft'"/>
                            <field name="effective_to" readonly="state != 'draft'"/>
                            <field name="is_current"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Method Parameters (formula currency)" name="parameters">
                        <group>
                            <field name="fixed_amount" invisible="method != 'fixed'"
                                   readonly="state != 'draft'"/>
                            <field name="unit_rate" invisible="method != 'per_unit'"
                                   readonly="state != 'draft'"/>
                            <field name="visit_rate" invisible="method != 'per_visit'"
                                   readonly="state != 'draft'"/>
                            <field name="percentage" invisible="method != 'percentage'"
                                   readonly="state != 'draft'"/>
                            <field name="tier_basis" invisible="method != 'tiered'"
                                   readonly="state != 'draft'"/>
                            <field name="site_rate" invisible="method != 'site'"
                                   readonly="state != 'draft'"/>
                            <field name="usage_base" invisible="method != 'usage'"
                                   readonly="state != 'draft'"/>
                            <field name="usage_rate" invisible="method != 'usage'"
                                   readonly="state != 'draft'"/>
                            <field name="hybrid_expression" invisible="method != 'hybrid'"
                                   readonly="state != 'draft'"
                                   placeholder="max(min_price, 20000 + equipment_value * 0.05 + visit_count * 1500)"/>
                        </group>
                        <group>
                            <field name="min_price" readonly="state != 'draft'"/>
                            <field name="max_price" readonly="state != 'draft'"/>
                            <field name="rounding_step" readonly="state != 'draft'"/>
                            <field name="rounding_method" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="method not in ('per_unit', 'percentage', 'hybrid')">
                        Pricing factors: applied per equipment line for Per Unit and Percentage; Hybrid uses the
                        quantity-weighted factor as variable "factor"; other methods do not use factors.
                    </div>
                    <notebook>
                        <page string="Tiers" name="tiers" invisible="method != 'tiered'">
                            <field name="tier_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="from_value"/>
                                    <field name="to_value"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pricing Factors" name="factors"
                              invisible="method not in ('per_unit', 'percentage', 'hybrid')">
                            <field name="factor_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="category_id"/>
                                    <field name="factor"/>
                                </list>
                            </field>
                        </page>
                        <page string="Target Currency Rounding" name="rounding">
                            <field name="rounding_rule_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="currency_id" options="{'no_create': True}"/>
                                    <field name="step"/>
                                    <field name="method"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sample Preview" name="sample">
                            <group>
                                <group>
                                    <field name="sample_product_id"/>
                                    <field name="sample_quantity"/>
                                    <field name="sample_equipment_value"/>
                                    <field name="sample_site_count"/>
                                    <field name="sample_usage"/>
                                </group>
                                <group>
                                    <field name="sample_result"/>
                                </group>
                            </group>
                            <field name="sample_breakdown" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="amc_pricing_formula_view_search" model="ir.ui.view">
        <field name="name">amc.pricing.formula.search</field>
        <field name="model">amc.pricing.formula</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_plan" string="AMC Plan" context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amc_pricing_formula" model="ir.actions.act_window">
        <field name="name">Pricing Formulas</field>
        <field name="res_model">amc.pricing.formula</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_plan': 1}</field>
    </record>

    <!-- Plan form: formula versions and the price preview. -->
    <record id="amc_plan_view_form_pricing" model="ir.ui.view">
        <field name="name">amc.plan.form.pricing</field>
        <field name="model">amc.plan</field>
        <field name="inherit_id" ref="amc_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_pricing_preview" type="object" string="Price Preview"
                            invisible="not id"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='pricing_method']" position="after">
                <field name="current_formula_id"/>
            </xpath>
            <xpath expr="//page[@name='applicability']" position="before">
                <page string="Pricing Formulas" name="pricing_formulas">
                    <field name="formula_ids" context="{'default_plan_id': id}">
                        <list decoration-muted="state == 'archived'" decoration-info="state == 'draft'">
                            <field name="version"/>
                            <field name="method"/>
                            <field name="currency_id"/>
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
