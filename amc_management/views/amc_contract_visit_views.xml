<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AMC visits / service entitlements (AMC-E03, F13, H01, H02). -->
    <record id="amc_contract_visit_view_list" model="ir.ui.view">
        <field name="name">amc.contract.visit.list</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <list string="AMC Visits" create="0" delete="0"
                  decoration-muted="state in ('cancelled', 'expired')"
                  decoration-danger="due_status == 'overdue'"
                  decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="site_id" optional="show"/>
                <field name="plan_id" optional="show"/>
                <field name="label"/>
                <field name="product_id"/>
                <field name="serial_id" optional="show"/>
                <field name="due_date"/>
                <field name="usage_due" optional="hide"/>
                <field name="usage_unit" optional="hide"/>
                <field name="scheduled_date" optional="show"/>
                <field name="completion_date" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="contract_state" optional="hide"/>
                <field name="due_status" widget="badge" optional="show"
                       decoration-danger="due_status == 'overdue'"
                       decoration-warning="due_status == 'due'"/>
                <field name="state" widget="badge" decoration-info="state == 'scheduled'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state in ('in_progress', 'missed')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="amc_contract_visit_view_form" model="ir.ui.view">
        <field name="name">amc.contract.visit.form</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <form string="AMC Visit" create="0" delete="0">
                <header>
                    <button name="action_open_complete_wizard" type="object" string="Complete"
                            class="btn-primary" invisible="state not in ('pending', 'scheduled', 'in_progress')"
                            groups="amc_management.amc_management_group_coordinator"/>
                    <button name="action_reopen" type="object" string="Reopen (Carry Forward)"
                            invisible="state != 'missed'" groups="amc_management.amc_management_group_manager"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel"
                            invisible="state not in ('pending', 'scheduled', 'missed')"
                            groups="amc_management.amc_management_group_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" string="Contract"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="label"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="contract_state"/>
                            <field name="partner_id"/>
                            <field name="site_id"/>
                            <field name="plan_id"/>
                            <field name="line_id"/>
                            <field name="product_id"/>
                            <field name="serial_id"/>
                            <field name="unit_no"/>
                        </group>
                        <group>
                            <field name="visit_type"/>
                            <field name="due_date" invisible="not due_date"/>
                            <label for="usage_due" invisible="not usage_unit"/>
                            <div class="o_row" invisible="not usage_unit">
                                <field name="usage_due"/>
                                <field name="usage_unit"/>
                            </div>
                            <field name="alert_date" invisible="not alert_date"/>
                            <field name="grace_end_date" invisible="not grace_end_date"/>
                            <field name="due_status" invisible="not due_status"/>
                            <field name="scheduled_date"
                                   readonly="state not in ('pending', 'scheduled') or contract_state not in ('active', 'expiring')"/>
                            <field name="completion_date" invisible="not completion_date"/>
                            <field name="completed_by_id" invisible="not completed_by_id"/>
                            <field name="usage_reading" invisible="not usage_reading"/>
                            <field name="consumption_source" invisible="not consumption_source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group invisible="not cancel_reason">
                        <field name="cancel_reason"/>
                    </group>
                    <field name="note" placeholder="Service notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="amc_contract_visit_view_kanban" model="ir.ui.view">
        <field name="name">amc.contract.visit.kanban</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="0" group_create="0" group_delete="0"
                    records_draggable="0" sample="1">
                <field name="due_status"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="label"/>
                        <field name="partner_id"/>
                        <field name="product_id" class="text-muted"/>
                        <footer>
                            <field name="due_date"/>
                            <field name="due_status" widget="badge" class="ms-auto"
                                   decoration-danger="due_status == 'overdue'"
                                   decoration-warning="due_status == 'due'"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="amc_contract_visit_view_calendar" model="ir.ui.view">
        <field name="name">amc.contract.visit.calendar</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <calendar string="AMC Visits" date_start="due_date" mode="month" color="plan_id"
                      create="0" quick_create="0" event_open_popup="1">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="label"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="amc_contract_visit_view_pivot" model="ir.ui.view">
        <field name="name">amc.contract.visit.pivot</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <pivot string="AMC Visit Schedule" sample="1">
                <field name="plan_id" type="row"/>
                <field name="due_date" interval="month" type="col"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="amc_contract_visit_view_graph" model="ir.ui.view">
        <field name="name">amc.contract.visit.graph</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <graph string="AMC Visit Schedule" type="bar" sample="1">
                <field name="due_date" interval="month"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="amc_contract_visit_view_search" model="ir.ui.view">
        <field name="name">amc.contract.visit.search</field>
        <field name="model">amc.contract.visit</field>
        <field name="arch" type="xml">
            <search string="AMC Visits">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="plan_id" string="AMC Type / Plan"/>
                <field name="product_id"/>
                <field name="serial_id"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'in', ('pending', 'scheduled', 'in_progress'))]"/>
                <filter name="filter_planned" string="Planned"
                        domain="[('state', 'in', ('scheduled', 'in_progress'))]"/>
                <filter name="filter_due" string="Due" domain="[('due_status', '=', 'due')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('due_status', '=', 'overdue')]"/>
                <filter name="filter_missed" string="Missed" domain="[('state', '=', 'missed')]"/>
                <filter name="filter_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="filter_preventive" string="Preventive Visits"
                        domain="[('visit_type', '=', 'preventive')]"/>
                <filter name="filter_free" string="Included Free Services"
                        domain="[('visit_type', '=', 'free_service')]"/>
                <separator/>
                <filter name="filter_contract_on_hold" string="Contract On Hold"
                        domain="[('contract_state', '=', 'on_hold')]"/>
                <filter name="filter_contract_renewed" string="Contract Renewed"
                        domain="[('contract_state', '=', 'renewed')]"/>
                <filter name="filter_contract_running" string="Contract Running"
                        domain="[('contract_state', 'in', ('active', 'expiring', 'on_hold'))]"/>
                <separator/>
                <filter name="filter_due_date" string="Due Date" date="due_date"/>
                <group>
                    <filter name="group_plan" string="AMC Type / Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_due_month" string="Due Month" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="amc_contract_visit_action" model="ir.actions.act_window">
        <field name="name">AMC Visits</field>
        <field name="res_model">amc.contract.visit</field>
        <field name="view_mode">list,kanban,calendar,form,pivot,graph</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AMC visit yet</p>
            <p>Preventive visits and included free services are generated when an AMC contract
                becomes Active.</p>
        </field>
    </record>

    <!-- AMC-H01: AMC Visit Schedule report (SRS 15): planned, due, overdue, held and renewed
         visits / contracts; filters AMC type, due date, customer, site. -->
    <record id="amc_contract_visit_action_schedule_report" model="ir.actions.act_window">
        <field name="name">AMC Visit Schedule</field>
        <field name="res_model">amc.contract.visit</field>
        <field name="view_mode">pivot,graph,list,kanban,calendar,form</field>
        <field name="context">{'search_default_filter_preventive': 1, 'search_default_group_plan': 1}</field>
        <field name="view_id" ref="amc_contract_visit_view_pivot"/>
    </record>

    <menuitem id="amc_contract_visit_menu" name="AMC Visits" parent="amc_management_menu_services"
              action="amc_contract_visit_action" sequence="10"/>
    <menuitem id="amc_contract_visit_menu_schedule_report" name="AMC Visit Schedule"
              parent="amc_management_menu_reporting"
              action="amc_contract_visit_action_schedule_report" sequence="10"/>
</odoo>
