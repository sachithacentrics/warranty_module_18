<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AMC roles (Mapping 17 / SRS 15). Technicians (Field Service), accountants (Accounting)
         and administrators (Settings) keep their standard Odoo groups. -->
    <record id="module_category_amc" model="ir.module.category">
        <field name="name">AMC Management</field>
        <field name="description">Annual Maintenance Contracts</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_amc_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_amc"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reads AMC plans, contracts and visits; prepares draft records.</field>
    </record>

    <record id="group_amc_coordinator" model="res.groups">
        <field name="name">Coordinator</field>
        <field name="category_id" ref="module_category_amc"/>
        <field name="implied_ids" eval="[(4, ref('group_amc_user'))]"/>
        <field name="comment">Manages AMC quotations, visit schedules and service requests.</field>
    </record>

    <record id="group_amc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_amc"/>
        <field name="implied_ids" eval="[(4, ref('group_amc_coordinator'))]"/>
        <field name="comment">Configures AMC plans and billing plans; holds, renews and closes contracts.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Approved B9: price overrides are approved by an AMC Approver (never the requester);
         independent of the User / Coordinator / Manager levels. -->
    <record id="module_category_amc_approval" model="ir.module.category">
        <field name="name">AMC Approval</field>
        <field name="sequence">61</field>
    </record>

    <record id="group_amc_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_amc_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_amc_user'))]"/>
        <field name="comment">Approves AMC price overrides (never their own requests).</field>
    </record>

    <!-- Multi-company: records of the user's companies, or shared (no company). -->
    <record id="amc_plan_company_rule" model="ir.rule">
        <field name="name">AMC Plan: multi-company</field>
        <field name="model_id" ref="model_amc_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_billing_plan_company_rule" model="ir.rule">
        <field name="name">AMC Billing Plan: multi-company</field>
        <field name="model_id" ref="model_amc_billing_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_pricing_formula_company_rule" model="ir.rule">
        <field name="name">AMC Pricing Formula: multi-company</field>
        <field name="model_id" ref="model_amc_pricing_formula"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_pricing_tier_company_rule" model="ir.rule">
        <field name="name">AMC Pricing Tier: multi-company</field>
        <field name="model_id" ref="model_amc_pricing_tier"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_pricing_factor_company_rule" model="ir.rule">
        <field name="name">AMC Pricing Factor: multi-company</field>
        <field name="model_id" ref="model_amc_pricing_factor"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_pricing_rounding_company_rule" model="ir.rule">
        <field name="name">AMC Pricing Rounding: multi-company</field>
        <field name="model_id" ref="model_amc_pricing_rounding"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_opportunity_company_rule" model="ir.rule">
        <field name="name">AMC Opportunity: multi-company</field>
        <field name="model_id" ref="model_amc_opportunity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_contract_company_rule" model="ir.rule">
        <field name="name">AMC Contract: multi-company</field>
        <field name="model_id" ref="model_amc_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_contract_line_company_rule" model="ir.rule">
        <field name="name">AMC Covered Equipment: multi-company</field>
        <field name="model_id" ref="model_amc_contract_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="amc_price_override_company_rule" model="ir.rule">
        <field name="name">AMC Override Request: multi-company</field>
        <field name="model_id" ref="model_amc_price_override"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
