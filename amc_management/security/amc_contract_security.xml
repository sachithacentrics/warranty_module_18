<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: records of the user's companies, or shared (no company). -->
    <record id="amc_contract_rule_company" model="ir.rule">
        <field name="name">AMC Contract: multi-company</field>
        <field name="model_id" ref="model_amc_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
