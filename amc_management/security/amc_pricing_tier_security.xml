<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: records of the user's companies, or shared (no company). -->
    <record id="amc_pricing_tier_rule_company" model="ir.rule">
        <field name="name">AMC Pricing Tier: multi-company</field>
        <field name="model_id" ref="model_amc_pricing_tier"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
