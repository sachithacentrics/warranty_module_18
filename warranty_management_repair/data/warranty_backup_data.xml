<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- SRS 2.15 sample BKU/00012. -->
    <record id="seq_warranty_backup_unit" model="ir.sequence">
        <field name="name">Warranty Backup Unit</field>
        <field name="code">warranty.backup.unit</field>
        <field name="prefix">BKU/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="ir_cron_warranty_backup_overdue" model="ir.cron">
        <field name="name">Warranty: Backup Units Overdue</field>
        <field name="model_id" ref="model_warranty_backup_unit"/>
        <field name="state">code</field>
        <field name="code">model._cron_warranty_backup_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
