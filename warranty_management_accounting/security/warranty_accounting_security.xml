<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Part 8.1: company rule; coordinators, requisition, accounting and purchase users see the
         company's cost lines; other internal users (named approvers) only read the lines routed
         to them; technicians see nothing else. -->
    <record id="rule_warranty_cost_line_company" model="ir.rule">
        <field name="name">warranty_cost_line: multi-company</field>
        <field name="model_id" ref="model_warranty_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_warranty_cost_line_staff" model="ir.rule">
        <field name="name">warranty_cost_line: coordinators, requisition, accounting and purchase users</field>
        <field name="model_id" ref="model_warranty_cost_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user')), (4, ref('material_purchase_requisitions.group_purchase_requisition_user')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_invoice')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <!-- SRS 15 Warranty History Report: cost line rows for the users who see the company's cost
         lines; journal entry rows for accounting users only. -->
    <record id="rule_warranty_history_internal" model="ir.rule">
        <field name="name">warranty.history: no cost / journal entry rows</field>
        <field name="model_id" ref="warranty_management.model_warranty_history"/>
        <field name="domain_force">[('entity', 'not in', ('cost', 'accounting'))]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_warranty_history_cost" model="ir.rule">
        <field name="name">warranty.history: cost line rows</field>
        <field name="model_id" ref="warranty_management.model_warranty_history"/>
        <field name="domain_force">[('entity', '!=', 'accounting')]</field>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user')), (4, ref('material_purchase_requisitions.group_purchase_requisition_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="rule_warranty_history_accounting" model="ir.rule">
        <field name="name">warranty.history: accounting users</field>
        <field name="model_id" ref="warranty_management.model_warranty_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="rule_warranty_cost_line_approver" model="ir.rule">
        <field name="name">warranty_cost_line: named approvers (read)</field>
        <field name="model_id" ref="model_warranty_cost_line"/>
        <field name="domain_force">[('approver_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
