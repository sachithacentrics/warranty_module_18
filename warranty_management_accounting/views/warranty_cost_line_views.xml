<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_cost_line_view_list" model="ir.ui.view">
        <field name="name">warranty.cost.line.list</field>
        <field name="model">warranty.cost.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('rejected', 'reversed')">
                <field name="name"/>
                <field name="case_id"/>
                <field name="job_id" optional="show"/>
                <field name="repair_id" optional="show"/>
                <field name="cost_type"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="estimated_amount" sum="Total"/>
                <field name="approved_amount" sum="Total"/>
                <field name="counted_actual_amount" string="Actual" sum="Total"/>
                <field name="source_reference" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state in ('rejected', 'reversed')"/>
            </list>
        </field>
    </record>

    <record id="warranty_cost_line_view_form" model="ir.ui.view">
        <field name="name">warranty.cost.line.form</field>
        <field name="model">warranty.cost.line</field>
        <field name="arch" type="xml">
            <form string="Warranty Cost Line">
                <header>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_reverse" invisible="1"/>
                    <field name="can_record_actual" invisible="1"/>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_open_reject" type="object" string="Reject"
                            invisible="not can_approve"/>
                    <button name="action_open_record_actual" type="object" string="Update Actual Cost"
                            invisible="not can_record_actual"/>
                    <button name="action_open_reverse" type="object" string="Reverse"
                            invisible="not can_reverse"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not source_warning">
                        <field name="source_warning" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="actual_is_manual" invisible="1"/>
                            <field name="cost_type" readonly="state != 'draft'"/>
                            <field name="job_id" readonly="state != 'draft'" invisible="repair_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="repair_id" readonly="state != 'draft'" invisible="job_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="estimated_amount" readonly="state != 'draft'"/>
                            <field name="approved_amount"/>
                            <field name="actual_amount" readonly="state != 'draft'"
                                   invisible="not actual_is_manual"/>
                            <field name="cost_date" readonly="state != 'draft'"
                                   invisible="not actual_is_manual"/>
                            <field name="source_amount" string="Actual (from bills)"
                                   invisible="cost_type != 'subcontract'"/>
                            <field name="expected_amount"/>
                        </group>
                    </group>
                    <group string="Purchase or Vendor Bill" invisible="cost_type != 'subcontract'">
                        <field name="source_reference" invisible="not source_reference"/>
                        <field name="source_commitment" invisible="not purchase_line_id"/>
                        <field name="purchase_line_id" readonly="state != 'draft'"
                               invisible="bill_line_id"
                               groups="account.group_account_invoice,purchase.group_purchase_user"
                               domain="[('state', 'in', ('purchase', 'done')), ('company_id', '=', company_id), ('product_id.is_storable', '=', False), ('custom_requisition_line_id', '=', False)]"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="bill_line_id" readonly="state != 'draft'"
                               invisible="purchase_line_id"
                               groups="account.group_account_invoice,purchase.group_purchase_user"
                               domain="[('move_id.move_type', '=', 'in_invoice'), ('parent_state', '=', 'posted'), ('display_type', '=', 'product'), ('company_id', '=', company_id), ('product_id.is_storable', '=', False)]"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="rejection_reason" invisible="state != 'rejected'"/>
                        <field name="reversal_reason" invisible="state != 'reversed'"/>
                    </group>
                    <notebook>
                        <page string="Approval" name="approval">
                            <group>
                                <group>
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_date"/>
                                    <field name="finance_required"/>
                                </group>
                                <group>
                                    <field name="manager_approved_by_id"/>
                                    <field name="manager_approved_date"/>
                                    <field name="finance_approved_by_id" invisible="not finance_required"/>
                                    <field name="finance_approved_date" invisible="not finance_required"/>
                                    <field name="rejected_by_id" invisible="state != 'rejected'"/>
                                    <field name="rejected_date" invisible="state != 'rejected'"/>
                                    <field name="reversed_by_id" invisible="state != 'reversed'"/>
                                    <field name="reversed_date" invisible="state != 'reversed'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_cost_line_view_search" model="ir.ui.view">
        <field name="name">warranty.cost.line.search</field>
        <field name="model">warranty.cost.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="case_id"/>
                <field name="job_id"/>
                <field name="repair_id"/>
                <filter name="pending" string="Waiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_case" string="Warranty Case" context="{'group_by': 'case_id'}"/>
                    <filter name="group_type" string="Cost Type" context="{'group_by': 'cost_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_cost_line" model="ir.actions.act_window">
        <field name="name">Warranty Cost Lines</field>
        <field name="res_model">warranty.cost.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No warranty cost lines yet</p>
            <p>Record labour estimates, workshop labour, travel, subcontract and other warranty
               costs. Parts and timesheet labour are read from their own records.</p>
        </field>
    </record>

    <menuitem id="menu_warranty_cost_line" name="Costs"
              parent="warranty_management.menu_warranty_root" action="action_warranty_cost_line"
              sequence="80"
              groups="helpdesk.group_helpdesk_user,material_purchase_requisitions.group_purchase_requisition_user,account.group_account_readonly,account.group_account_invoice"/>
</odoo>
