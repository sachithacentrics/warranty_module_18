<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_warranty_reserve_report_company" model="ir.rule">
        <field name="name">warranty_reserve_report: multi-company</field>
        <field name="model_id" ref="model_warranty_reserve_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_warranty_reserve_report_own" model="ir.rule">
        <field name="name">warranty_reserve_report: own rows</field>
        <field name="model_id" ref="model_warranty_reserve_report"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="warranty_reserve_report_view_list" model="ir.ui.view">
        <field name="name">warranty.reserve.report.list</field>
        <field name="model">warranty.reserve.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" import="false"
                  action="action_open_source" type="object">
                <header>
                    <button name="action_open_warranty_reserve_report" type="object" string="Refresh"
                            display="always"/>
                </header>
                <field name="date"/>
                <field name="movement_type"/>
                <field name="move_id" optional="show"/>
                <field name="move_state" optional="show"/>
                <field name="invoice_id" optional="show"/>
                <field name="refund_id" optional="hide"/>
                <field name="case_id" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="product_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="policy_id" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="provision_amount" sum="Total"/>
                <field name="reversal_amount" sum="Total"/>
                <field name="utilization_amount" sum="Total"/>
                <field name="release_amount" sum="Total"/>
                <field name="other_amount" sum="Total" optional="show"/>
                <field name="reserve_amount" sum="Total"/>
                <field name="draft_amount" sum="Total" optional="show"/>
                <field name="actual_cost_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="warranty_reserve_report_view_pivot" model="ir.ui.view">
        <field name="name">warranty.reserve.report.pivot</field>
        <field name="model">warranty.reserve.report</field>
        <field name="arch" type="xml">
            <pivot string="Warranty Reserve">
                <field name="date" interval="month" type="row"/>
                <field name="movement_type" type="col"/>
                <field name="reserve_amount" type="measure"/>
                <field name="actual_cost_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="warranty_reserve_report_view_search" model="ir.ui.view">
        <field name="name">warranty.reserve.report.search</field>
        <field name="model">warranty.reserve.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="policy_id"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="move_id"/>
                <field name="invoice_id"/>
                <field name="case_id"/>
                <filter name="reserve" string="Reserve Movements" domain="[('movement_type', '!=', 'actual_cost')]"/>
                <filter name="actual_cost" string="Actual Warranty Cost" domain="[('movement_type', '=', 'actual_cost')]"/>
                <separator/>
                <filter name="draft" string="Draft Entries" domain="[('move_state', '=', 'draft')]"/>
                <filter name="unclassified" string="Unclassified Manual" domain="[('movement_type', '=', 'other')]"/>
                <separator/>
                <filter name="period" string="Period" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_policy" string="Warranty Policy" context="{'group_by': 'policy_id'}"/>
                    <filter name="group_category" string="Product Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_type" string="Movement" context="{'group_by': 'movement_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_reserve_report" model="ir.actions.act_window">
        <field name="name">Warranty Provision / Reserve</field>
        <field name="res_model">warranty.reserve.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No warranty reserve movements yet</p>
            <p>Provisions, reversals, utilization, releases and the outstanding reserve from posted
               journal items, with operational actual cost for comparison.</p>
        </field>
    </record>

    <record id="action_server_warranty_reserve_report" model="ir.actions.server">
        <field name="name">Warranty Provision / Reserve</field>
        <field name="model_id" ref="model_warranty_reserve_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_warranty_reserve_report()</field>
        <field name="groups_id" eval="[(6, 0, [ref('account.group_account_readonly'), ref('account.group_account_invoice')])]"/>
    </record>

    <menuitem id="menu_warranty_reserve_report" name="Warranty Provision / Reserve"
              parent="warranty_management_mrf.menu_warranty_reports"
              action="action_server_warranty_reserve_report" sequence="4"
              groups="account.group_account_readonly,account.group_account_invoice"/>
    <menuitem id="menu_warranty_reserve_report_accounting" name="Warranty Provision / Reserve"
              parent="account.menu_finance_reports"
              action="action_server_warranty_reserve_report" sequence="88"
              groups="account.group_account_readonly,account.group_account_invoice"/>

    <!-- Finance labels a manual entry on the reserve account; nothing sets this automatically. -->
    <record id="view_move_form_warranty_reserve_movement" model="ir.ui.view">
        <field name="name">account.move.form.warranty.reserve.movement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="warranty_management_accounting.view_move_form_warranty_provision"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='warranty_provision']" position="after">
                <group string="Warranty Reserve" name="warranty_reserve"
                       invisible="warranty_provision_invoice_id or reversed_entry_id"
                       groups="account.group_account_readonly,account.group_account_invoice">
                    <field name="warranty_reserve_movement" readonly="state != 'draft'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
