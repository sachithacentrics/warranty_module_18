<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phase 5.1: warranty links and estimated cost on the vendor requisition form; standalone
         requisitions show nothing new. -->
    <record id="material_purchase_requisition_view_form_warranty" model="ir.ui.view">
        <field name="name">material.purchase.requisition.form.warranty</field>
        <field name="model">material.purchase.requisition</field>
        <field name="inherit_id" ref="material_purchase_requisitions.material_purchase_requisition_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='requisition_confirm']" position="after">
                <!-- Phase 5.2: coverage decision (mapping D7). -->
                <!-- UX: while coverage is pending, Submit is refused (T2.3): the coverage step is
                     the primary action (Decide Coverage for a reviewer, else Request Coverage
                     Decision); a decided request keeps Decide Coverage as secondary. -->
                <button name="action_request_coverage_decision" type="object"
                        string="Request Coverage Decision" class="btn-primary"
                        invisible="not is_warranty_mrf or state != 'draft' or not coverage_pending_count or can_decide_coverage"/>
                <button name="action_request_coverage_decision" type="object"
                        string="Request Coverage Decision"
                        invisible="not is_warranty_mrf or state != 'draft' or not coverage_pending_count or not can_decide_coverage"/>
                <button name="action_decide_coverage" type="object" string="Decide Coverage"
                        class="btn-primary" invisible="not can_decide_coverage or not coverage_pending_count"/>
                <button name="action_decide_coverage" type="object" string="Decide Coverage"
                        invisible="not can_decide_coverage or coverage_pending_count"/>
            </xpath>
            <xpath expr="//button[@name='requisition_confirm']" position="attributes">
                <attribute name="invisible">state != 'draft' or (is_warranty_mrf and coverage_pending_count)</attribute>
            </xpath>
            <xpath expr="//sheet/*[1]" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not is_warranty_mrf or state != 'draft' or not coverage_pending_count">
                    <field name="coverage_pending_count" class="oe_inline"/> line(s) pending a coverage
                    decision: the request can be confirmed once a coverage reviewer has decided them
                    (Request Coverage Decision).
                </div>
            </xpath>
            <xpath expr="//button[@name='show_picking']" position="attributes">
                <attribute name="invisible">not warranty_picking_count</attribute>
            </xpath>
            <xpath expr="//button[@name='action_show_po']" position="attributes">
                <attribute name="invisible">not warranty_purchase_count</attribute>
            </xpath>
            <xpath expr="//notebook" position="before">
                <field name="warranty_picking_count" invisible="1"/>
                <field name="warranty_purchase_count" invisible="1"/>
                <field name="is_warranty_mrf" invisible="1"/>
                <field name="can_decide_coverage" invisible="1"/>
                <group string="Warranty" name="warranty_links" invisible="not is_warranty_mrf">
                    <group>
                        <field name="warranty_case_id"/>
                        <field name="warranty_service_job_id" invisible="not warranty_service_job_id"/>
                        <field name="warranty_task_id" invisible="not warranty_task_id"/>
                        <field name="warranty_helpdesk_ticket_id"/>
                    </group>
                    <group>
                        <field name="warranty_partner_id"/>
                        <field name="warranty_site_id" invisible="not warranty_site_id"/>
                        <field name="warranty_product_id"/>
                        <field name="warranty_serial_id" invisible="not warranty_serial_id"/>
                        <field name="warranty_card_id" invisible="not warranty_card_id"/>
                        <field name="warranty_unit_id" invisible="not warranty_unit_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="estimated_cost"/>
                        <field name="coverage_status" widget="badge"
                               decoration-warning="coverage_status == 'pending'"
                               decoration-success="coverage_status == 'covered'"
                               decoration-danger="coverage_status == 'not_covered'"
                               decoration-info="coverage_status == 'mixed'"/>
                        <field name="coverage_requested_by_id" invisible="not coverage_requested_by_id"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='requisition_line_ids']/list/field[@name='uom']" position="after">
                <field name="currency_id" column_invisible="True"/>
                <field name="lot_ids" widget="many2many_tags" optional="show"
                       column_invisible="not parent.is_warranty_mrf"/>
                <field name="estimated_unit_cost" column_invisible="not parent.is_warranty_mrf"/>
                <field name="estimated_cost" sum="Total" column_invisible="not parent.is_warranty_mrf"/>
                <field name="coverage_type" widget="badge" column_invisible="not parent.is_warranty_mrf"
                       decoration-warning="coverage_type == 'pending'"
                       decoration-success="coverage_type == 'covered'"
                       decoration-danger="coverage_type == 'not_covered'"/>
                <field name="goodwill" optional="show" column_invisible="not parent.is_warranty_mrf"/>
                <field name="coverage_default_reason" optional="hide" column_invisible="not parent.is_warranty_mrf"/>
                <field name="coverage_decided_by_id" optional="hide" column_invisible="not parent.is_warranty_mrf"/>
                <field name="coverage_decision_date" optional="hide" column_invisible="not parent.is_warranty_mrf"/>
                <field name="coverage_decision_reason" optional="hide" column_invisible="not parent.is_warranty_mrf"/>
            </xpath>
            <xpath expr="//field[@name='requisition_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="readonly">parent.is_warranty_mrf and parent.state != 'draft'</attribute>
            </xpath>
        </field>
    </record>

    <record id="material_purchase_requisition_view_list_warranty" model="ir.ui.view">
        <field name="name">material.purchase.requisition.list.warranty</field>
        <field name="model">material.purchase.requisition</field>
        <field name="inherit_id" ref="material_purchase_requisitions.material_purchase_requisition_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="before">
                <field name="warranty_case_id" optional="show"/>
                <field name="warranty_service_job_id" optional="show"/>
                <field name="warranty_partner_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="currency_id" column_invisible="True"/>
                <field name="estimated_cost" optional="show" sum="Total"/>
                <field name="coverage_status" optional="show" widget="badge"
                       decoration-warning="coverage_status == 'pending'"
                       decoration-success="coverage_status == 'covered'"
                       decoration-danger="coverage_status == 'not_covered'"
                       decoration-info="coverage_status == 'mixed'"/>
            </xpath>
        </field>
    </record>

    <record id="material_purchase_requisition_view_search_warranty" model="ir.ui.view">
        <field name="name">material.purchase.requisition.search.warranty</field>
        <field name="model">material.purchase.requisition</field>
        <field name="inherit_id" ref="material_purchase_requisitions.material_purchase_requisition_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="warranty_case_id"/>
                <field name="warranty_service_job_id"/>
                <field name="warranty_partner_id"/>
                <field name="warranty_helpdesk_ticket_id"/>
                <filter string="Warranty Requests" name="warranty" domain="[('is_warranty_mrf', '=', True)]"/>
                <filter string="Standalone Requests" name="standalone" domain="[('is_warranty_mrf', '=', False)]"/>
                <filter string="Coverage Pending" name="coverage_pending" domain="[('coverage_status', '=', 'pending')]"/>
            </xpath>
            <xpath expr="//filter[@name='employee_id']" position="before">
                <filter string="Warranty Case" name="group_warranty_case" context="{'group_by': 'warranty_case_id'}"/>
                <filter string="Service Job" name="group_service_job" context="{'group_by': 'warranty_service_job_id'}"/>
                <filter string="Coverage" name="group_coverage" context="{'group_by': 'coverage_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- Warranty -> Material Requests (SRS menu "Material Requests"): warranty requisitions only;
         new requests are created from the case, service job or visit. -->
    <record id="action_warranty_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">material.purchase.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_warranty_mrf', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No warranty material request yet</p>
            <p>Create Material Requests from a warranty case, service job or Field Service visit.</p>
        </field>
    </record>

    <menuitem id="menu_warranty_material_request" name="Material Requests"
              parent="warranty_management.menu_warranty_root" action="action_warranty_material_request"
              sequence="50"
              groups="helpdesk.group_helpdesk_user,industry_fsm.group_fsm_user,material_purchase_requisitions.group_purchase_requisition_user,stock.group_stock_user"/>
</odoo>
