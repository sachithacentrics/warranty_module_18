<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_team_view_form_warranty" model="ir.ui.view">
        <field name="name">helpdesk.team.form.warranty</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='after-sales']" position="inside">
                <setting id="warranty_inspection" string="Warranty Inspection"
                         help="Chargeable warranty cases get a draft inspection quotation">
                    <field name="warranty_inspection_required"/>
                    <div class="mt8" invisible="not warranty_inspection_required">
                        <div class="row">
                            <label for="warranty_inspection_product_id" class="col-lg-4 o_light_label"/>
                            <field name="warranty_inspection_product_id" required="warranty_inspection_required"/>
                        </div>
                        <div class="row">
                            <label for="warranty_inspection_amount" class="col-lg-4 o_light_label"/>
                            <field name="warranty_inspection_amount"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>


