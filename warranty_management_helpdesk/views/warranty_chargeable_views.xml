    <record id="sale_order_view_form_warranty_case" model="ir.ui.view">
        <field name="name">sale.order.form.warranty.case</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_warranty_customer_declined" type="object" string="Customer Declined (Warranty)"
                        groups="helpdesk.group_helpdesk_user"
                        invisible="not warranty_case_id or state not in ('draft', 'sent')"/>
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="warranty_case_id" invisible="not warranty_case_id"/>
            </field>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="warranty_inspection_coverage" optional="show"
                       column_invisible="not parent.warranty_case_id"/>
            </xpath>
        </field>
    </record>
</odoo>
