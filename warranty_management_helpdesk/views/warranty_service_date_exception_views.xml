<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Late Service Exceptions (BA-approved enhancement F5-F8, not an original SRS requirement). -->
    <record id="warranty_service_date_exception_view_list" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.list</field>
        <field name="model">warranty.service.date.exception</field>
        <field name="arch" type="xml">
            <list string="Late Service Exceptions" create="0" delete="0">
                <field name="entitlement_id"/>
                <field name="warranty_card_id"/>
                <field name="partner_id"/>
                <field name="due_date"/>
                <field name="grace_end_date"/>
                <field name="requested_date"/>
                <field name="requested_by_id"/>
                <field name="decided_by_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-warning="state == 'requested'"
                       decoration-danger="state in ('rejected', 'expired')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="warranty_service_date_exception_view_form" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.form</field>
        <field name="model">warranty.service.date.exception</field>
        <field name="arch" type="xml">
            <form string="Late Service Exception" create="0" delete="0" edit="0">
                <header>
                    <field name="can_decide" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not can_decide"
                            confirm="Approve this service date after the Grace Period End?"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="not can_decide"/>
                    <field name="group_id" invisible="1"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            invisible="state != 'requested' or group_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="entitlement_id"/>
                            <field name="group_id" invisible="not group_id"/>
                            <field name="warranty_card_id"/>
                            <field name="partner_id"/>
                            <field name="case_id" invisible="not case_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="grace_end_date"/>
                            <field name="warranty_end_date"/>
                            <field name="requested_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="requested_by_id"/>
                        <field name="requested_on"/>
                        <field name="decided_by_id" invisible="not decided_by_id"/>
                        <field name="decided_on" invisible="not decided_on"/>
                        <field name="decision_note" invisible="not decision_note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_service_date_exception_view_search" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.search</field>
        <field name="model">warranty.service.date.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="entitlement_id"/>
                <field name="warranty_card_id"/>
                <field name="partner_id"/>
                <filter name="filter_requested" string="Waiting for Approval"
                        domain="[('state', '=', 'requested')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>

    <record id="action_warranty_service_date_exception" model="ir.actions.act_window">
        <field name="name">Late Service Exceptions</field>
        <field name="res_model">warranty.service.date.exception</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_requested': 1}</field>
    </record>

    <!-- Parent of the Late Service Exception menus (requests and their per-service history). -->
    <menuitem id="menu_warranty_service_date_exception_root" name="Service Date Exceptions"
              parent="warranty_management.menu_warranty_free_services_root" sequence="30"/>

    <menuitem id="menu_warranty_service_date_exception" name="Exception History"
              action="action_warranty_service_date_exception"
              parent="menu_warranty_service_date_exception_root" sequence="20"/>

    <!-- Request groups (approved G1-G7, H5-A). -->
    <record id="warranty_service_date_exception_group_view_list" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.group.list</field>
        <field name="model">warranty.service.date.exception.group</field>
        <field name="arch" type="xml">
            <list string="Late Service Requests" create="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="requested_date"/>
                <field name="requested_by_id"/>
                <field name="decided_by_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-warning="state in ('requested', 'partly_expired')"
                       decoration-danger="state in ('rejected', 'expired')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="warranty_service_date_exception_group_view_form" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.group.form</field>
        <field name="model">warranty.service.date.exception.group</field>
        <field name="arch" type="xml">
            <form string="Late Service Request" create="0" delete="0" edit="0">
                <header>
                    <field name="can_decide" invisible="1"/>
                    <field name="can_approve" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve All"
                            class="btn-primary" invisible="not can_approve"
                            confirm="Approve the service date for all free services of this request?"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            invisible="not can_decide"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            invisible="state not in ('requested', 'partly_expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'partly_expired'">
                        A free service of this request expired before the approval: the request
                        cannot be approved. Reject or cancel it, then request again for the
                        remaining services.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="case_id" invisible="not case_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="requested_date"/>
                            <field name="requested_by_id"/>
                            <field name="requested_on"/>
                            <field name="decided_by_id" invisible="not decided_by_id"/>
                            <field name="decided_on" invisible="not decided_on"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="decision_note" invisible="not decision_note"/>
                    </group>
                    <field name="exception_ids">
                        <list>
                            <field name="entitlement_id"/>
                            <field name="warranty_card_id"/>
                            <field name="due_date"/>
                            <field name="grace_end_date"/>
                            <field name="warranty_end_date"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_service_date_exception_group_view_search" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.group.search</field>
        <field name="model">warranty.service.date.exception.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_open" string="Waiting for Decision"
                        domain="[('state', 'in', ('requested', 'partly_expired'))]"/>
            </search>
        </field>
    </record>

    <record id="action_warranty_service_date_exception_group" model="ir.actions.act_window">
        <field name="name">Late Service Requests</field>
        <field name="res_model">warranty.service.date.exception.group</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

    <menuitem id="menu_warranty_service_date_exception_group" name="Exception Requests"
              action="action_warranty_service_date_exception_group"
              parent="menu_warranty_service_date_exception_root" sequence="10"/>

    <record id="warranty_service_date_exception_wizard_view_form" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.wizard.form</field>
        <field name="model">warranty.service.date.exception.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Late Service Exception">
                <field name="service_ids" invisible="1"/>
                <group>
                    <field name="case_id" invisible="not case_id"/>
                    <field name="requested_date"/>
                    <field name="reason"
                           placeholder="Why must the service be done after the Grace Period End?"/>
                </group>
                <field name="entitlement_ids" options="{'no_create': True}">
                    <list>
                        <field name="name"/>
                        <field name="warranty_card_id"/>
                        <field name="due_date"/>
                        <field name="latest_service_date" string="Current Latest Date"/>
                    </list>
                </field>
                <footer>
                    <button name="action_request" type="object" string="Request Approval"
                            class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="warranty_service_date_exception_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">warranty.service.date.exception.reject.wizard.form</field>
        <field name="model">warranty.service.date.exception.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Late Service Exception">
                <group>
                    <field name="group_id" invisible="not group_id"/>
                    <field name="exception_id" invisible="not exception_id"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Request buttons and history on the free service and the case. -->
    <record id="warranty_service_entitlement_view_form_late_service" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.form.late.service</field>
        <field name="model">warranty.service.entitlement</field>
        <field name="inherit_id" ref="warranty_management.warranty_service_entitlement_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="late_service_handling" invisible="1"/>
                <button name="action_open_late_service_wizard" type="object"
                        string="Request Late Service Exception" groups="helpdesk.group_helpdesk_user"
                        invisible="late_service_handling != 'approval' or state in ('completed', 'expired', 'cancelled')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Late Service Exceptions" name="late_service_exceptions"
                      invisible="not service_date_exception_ids">
                    <field name="service_date_exception_ids"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="warranty_case_view_form_late_service" model="ir.ui.view">
        <field name="name">warranty.case.form.late.service</field>
        <field name="model">warranty.case</field>
        <field name="inherit_id" ref="warranty_case_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_late_service_wizard" type="object"
                        string="Request Late Service Exception" groups="helpdesk.group_helpdesk_user"
                        invisible="not service_entitlement_ids or state not in ('new', 'eligibility_checked', 'approved', 'job_created', 'in_progress')"/>
            </xpath>
        </field>
    </record>
</odoo>
