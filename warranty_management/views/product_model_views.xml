<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_model_view_list" model="ir.ui.view">
        <field name="name">product.model.list</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <list string="Product Models" editable="bottom">
                <field name="name"/>
                <field name="product_brand_id" options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="product_model_view_form" model="ir.ui.view">
        <field name="name">product.model.form</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <form string="Product Model">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="product_brand_id" options="{'no_create': True}"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_model_view_search" model="ir.ui.view">
        <field name="name">product.model.search</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <search string="Product Models">
                <field name="name"/>
                <field name="product_brand_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Brand" name="group_by_brand" context="{'group_by': 'product_brand_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_model_action" model="ir.actions.act_window">
        <field name="name">Product Models</field>
        <field name="res_model">product.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_model_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a product model</p>
        </field>
    </record>

    <!-- Inventory > Products, directly after Product Brands (sequence 3). -->
    <menuitem id="menu_product_model"
              name="Product Models"
              action="product_model_action"
              parent="stock.menu_stock_inventory_control"
              sequence="4"/>
</odoo>
