<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Start Date Automation (D1 / D1b): actual posting time and posting history of customer
         invoices / credit notes, read-only. -->
    <record id="view_move_form_warranty_posting" model="ir.ui.view">
        <field name="name">account.move.form.warranty.posting</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="warranty_posted_at"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="after">
                <page string="Posting History" name="warranty_posting_history"
                      invisible="move_type not in ('out_invoice', 'out_refund') or not warranty_posting_event_ids">
                    <field name="warranty_posting_event_ids" readonly="1">
                        <list>
                            <field name="event_datetime"/>
                            <field name="event"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
