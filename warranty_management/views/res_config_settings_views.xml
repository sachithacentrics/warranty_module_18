<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_warranty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.warranty</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Warranty" string="Warranty" name="warranty_management" groups="base.group_system">
                    <block title="General Warranty Settings" name="warranty_general_settings">
                        <setting id="warranty_scope_mode" string="Warranty Scope Mode"
                                 help="Capability blocks enabled for this company">
                            <field name="warranty_scope_mode"/>
                        </setting>
                        <setting id="warranty_default_policy" string="Default Warranty Policy"
                                 help="Company fallback warranty policy (of this company or shared); its values are shown read-only, edit the policy to change them">
                            <field name="warranty_default_policy_id"
                                   domain="[('company_id', 'in', [company_id, False])]"/>
                            <div class="mt8" invisible="not warranty_default_policy_id">
                                <div class="row">
                                    <label for="warranty_default_policy_basis" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_basis"/>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_duration" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_duration"/>
                                        <field name="warranty_default_policy_duration_unit"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_start_criterion" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_start_criterion"/>
                                </div>
                                <div class="row" invisible="warranty_default_policy_basis != 'usage'">
                                    <label for="warranty_default_policy_usage_limit" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_usage_limit"/>
                                        <field name="warranty_default_policy_usage_unit"/>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <setting id="warranty_default_card_grouping" string="Default Card Grouping Mode"
                                 help="How Sales Order lines are grouped into warranty cards" invisible="1">
                            <field name="warranty_default_card_grouping_mode"/>
                        </setting>
                        <setting id="warranty_default_basis" string="Default Warranty Basis"
                                 help="Date-based (Period) or meter-based (Usage) validity; with a policy, used only when the policy has none"
                                 invisible="warranty_default_policy_id and warranty_default_policy_basis">
                            <field name="warranty_default_basis"/>
                        </setting>
                        <setting id="warranty_default_start_criterion" string="Default Start Criterion"
                                 help="Date source used to start the warranty; with a policy, used only when the policy has none"
                                 invisible="warranty_default_policy_id and warranty_default_policy_start_criterion">
                            <field name="warranty_default_start_criterion"/>
                        </setting>
                        <setting id="warranty_default_duration" string="Default Warranty Duration"
                                 help="Company fallback warranty duration"
                                 invisible="warranty_default_policy_id">
                            <div class="o_row">
                                <field name="warranty_default_duration" required="warranty_scope_mode and not warranty_default_policy_id"/>
                                <field name="warranty_default_duration_unit" required="warranty_scope_mode and not warranty_default_policy_id"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Free Service Settings" name="warranty_free_service_settings"
                           invisible="warranty_scope_mode not in ('free_services', 'amc_free_services')">
                        <setting id="warranty_default_policy_free_services" string="Default Warranty Policy Free Services"
                                 help="Values of the Default Warranty Policy (read-only): edit the policy to change them"
                                 invisible="not warranty_default_policy_id">
                            <div class="mt8">
                                <div class="row">
                                    <label for="warranty_default_policy_free_service_count" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_free_service_count"/>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_free_service_period" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_free_service_period"/>
                                        <field name="warranty_default_policy_free_service_period_unit"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_free_service_frequency" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_free_service_frequency"/>
                                        <field name="warranty_default_policy_free_service_frequency_unit"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_schedule_method" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_schedule_method"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="warranty_default_free_service_count" string="Default Free Service Count"
                                 help="Free services at the company fallback level"
                                 invisible="warranty_default_policy_id">
                            <field name="warranty_default_free_service_count"/>
                        </setting>
                        <setting id="warranty_default_free_service_period" string="Default Free Service Period"
                                 help="Period in which the free services are scheduled, when the warranty policy has none"
                                 invisible="warranty_default_policy_id and warranty_default_policy_free_service_period and warranty_default_policy_free_service_period_unit">
                            <div class="o_row">
                                <field name="warranty_default_free_service_period"/>
                                <field name="warranty_default_free_service_period_unit"/>
                            </div>
                        </setting>
                        <setting id="warranty_default_schedule_method" string="Default Schedule Method"
                                 help="How free service due dates are calculated, when the warranty policy has none"
                                 invisible="warranty_default_policy_id and warranty_default_policy_schedule_method">
                            <field name="warranty_default_schedule_method"/>
                        </setting>
                        <setting id="warranty_auto_create_services" string="Auto-create Services"
                                 help="Create draft services after warranty confirmation">
                            <field name="warranty_auto_create_services"/>
                        </setting>
                        <setting id="warranty_draft_job_from_service" string="Draft Job from Service"
                                 help="Services may create draft jobs" invisible="1">
                            <field name="warranty_draft_job_from_service"/>
                        </setting>
                    </block>
                    <block title="Free Service Monitoring" name="warranty_service_monitoring_settings"
                           invisible="warranty_scope_mode not in ('free_services', 'amc_free_services')">
                        <setting id="warranty_service_alert_user" string="Service Alert Responsible Users"
                                 help="Fallback users for due alerts and expiry reminders when the warranty card has none; each user receives their own activity">
                            <field name="warranty_service_alert_user_ids" widget="many2many_tags"/>
                        </setting>
                        <setting id="warranty_timezone" string="Warranty Timezone"
                                 help="Timezone used to evaluate due and expiry dates (empty: company contact timezone, then UTC)">
                            <field name="warranty_timezone"/>
                        </setting>
                    </block>
                    <block title="Warranty Card PDF Download Approval" name="warranty_download_approval_settings">
                        <setting id="warranty_download_approval_required" string="Require PDF Download Approval"
                                 help="After the free downloads, each warranty card PDF download needs an approved request">
                            <field name="warranty_download_approval_required"/>
                        </setting>
                        <setting id="warranty_free_download_count" string="Free Download Count"
                                 help="Downloads per warranty card without approval (at least 1); the PDF generated at confirmation is not counted"
                                 invisible="not warranty_download_approval_required">
                            <field name="warranty_free_download_count"/>
                        </setting>
                        <setting id="warranty_download_approver_ids" string="Download Approval Responsible Users"
                                 help="Approve or reject the download requests of this company (never their own)"
                                 invisible="not warranty_download_approval_required">
                            <field name="warranty_download_approver_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_warranty_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'warranty_management', 'bin_size': False}</field>
    </record>
</odoo>
