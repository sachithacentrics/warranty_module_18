<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_warranty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.warranty</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Warranty" string="Warranty" name="warranty_management" groups="base.group_system">
                    <block title="General Warranty Settings" name="warranty_general_settings">
                        <setting id="warranty_default_policy" string="Default Warranty Policy"
                                 help="The warranty policy used when the pricelist, the product and the product category have no warranty policy. Its values are shown here read-only; edit the policy to change them.">
                            <field name="warranty_default_policy_id"
                                   domain="[('company_id', 'in', [company_id, False])]"/>
                            <div class="mt8" invisible="not warranty_default_policy_id">
                                <div class="row">
                                    <label for="warranty_default_policy_basis" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_basis"/>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_duration" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_duration"/>
                                        <field name="warranty_default_policy_duration_unit"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_start_criterion" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_start_criterion"/>
                                </div>
                                <div class="row" invisible="warranty_default_policy_basis != 'usage'">
                                    <label for="warranty_default_policy_usage_limit" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_usage_limit"/>
                                        <field name="warranty_default_policy_usage_unit"/>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <setting id="warranty_default_card_grouping" string="Default Card Grouping Mode"
                                 help="How Sales Order lines are grouped into warranty cards" invisible="1">
                            <field name="warranty_default_card_grouping_mode"/>
                        </setting>
                        <setting id="warranty_default_basis" string="Default Warranty Basis"
                                 invisible="warranty_default_policy_id and warranty_default_policy_basis"
                                 help="How the warranty is measured: by time (Period) or by use, such as running hours (Usage). Used when the warranty policy does not set it, or when no policy applies.">
                            <field name="warranty_default_basis"/>
                        </setting>
                        <setting id="warranty_default_start_criterion" string="Default Start Criterion"
                                 invisible="warranty_default_policy_id and warranty_default_policy_start_criterion"
                                 help="The event that starts the warranty: installation, delivery or invoice. Used when the warranty policy does not set it, or when no policy applies.">
                            <field name="warranty_default_start_criterion"/>
                        </setting>
                        <setting id="warranty_default_duration" string="Default Warranty Duration"
                                 invisible="warranty_default_policy_id"
                                 help="How long the warranty lasts when no warranty policy applies and the product and its category have no warranty period. Required when no Default Warranty Policy is selected."
                                 title="How long the warranty lasts when no warranty policy applies and the product and its category have no warranty period. Required when no Default Warranty Policy is selected.">
                            <div class="o_row">
                                <field name="warranty_default_duration" required="not warranty_default_policy_id"/>
                                <field name="warranty_default_duration_unit" required="not warranty_default_policy_id"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Free Service Settings" name="warranty_free_service_settings">
                        <setting id="warranty_default_policy_free_services" string="Default Warranty Policy Free Services"
                                 invisible="not warranty_default_policy_id"
                                 help="The free service values of the Default Warranty Policy, shown read-only. Edit the policy to change them."
                                 title="The free service values of the Default Warranty Policy, shown read-only. Edit the policy to change them.">
                            <div class="mt8">
                                <div class="row">
                                    <label for="warranty_default_policy_free_service_count" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_free_service_count"/>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_free_service_period" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_free_service_period"/>
                                        <field name="warranty_default_policy_free_service_period_unit"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_free_service_frequency" class="col-lg-5 o_light_label"/>
                                    <div class="col-lg-7 o_row">
                                        <field name="warranty_default_policy_free_service_frequency"/>
                                        <field name="warranty_default_policy_free_service_frequency_unit"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="warranty_default_policy_schedule_method" class="col-lg-5 o_light_label"/>
                                    <field name="warranty_default_policy_schedule_method"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="warranty_default_free_service_count" string="Default Free Service Count"
                                 invisible="warranty_default_policy_id"
                                 help="The number of free services given when no warranty policy applies and the product and its category have no free service count. 0 means no free services.">
                            <field name="warranty_default_free_service_count"/>
                        </setting>
                        <setting id="warranty_default_free_service_period" string="Default Free Service Period"
                                 invisible="warranty_default_policy_id and warranty_default_policy_free_service_period and warranty_default_policy_free_service_period_unit"
                                 help="The period over which the free services are spread, used when the warranty policy does not set one."
                                 title="The period over which the free services are spread, used when the warranty policy does not set one.">
                            <div class="o_row">
                                <field name="warranty_default_free_service_period"/>
                                <field name="warranty_default_free_service_period_unit"/>
                            </div>
                        </setting>
                        <setting id="warranty_default_schedule_method" string="Default Schedule Method"
                                 invisible="warranty_default_policy_id and warranty_default_policy_schedule_method"
                                 help="How free service due dates are calculated (equal intervals, or entered manually). Used when the warranty policy, the product and its category do not set a method.">
                            <field name="warranty_default_schedule_method"/>
                        </setting>
                        <setting id="warranty_auto_create_services" string="Auto-create Services"
                                 help="If enabled, free service entries are created automatically when a warranty card is confirmed. If disabled, they are added manually. Used only for cards without a warranty policy whose product and category do not enable it; a warranty policy's own setting always applies instead.">
                            <field name="warranty_auto_create_services"/>
                        </setting>
                        <setting id="warranty_draft_job_from_service" string="Draft Job from Service"
                                 help="Services may create draft jobs" invisible="1">
                            <field name="warranty_draft_job_from_service"/>
                        </setting>
                    </block>
                    <block title="Free Service Monitoring" name="warranty_service_monitoring_settings">
                        <setting id="warranty_service_alert_user" string="Service Alert Responsible Users"
                                 help="Users who receive the free service due alerts and expiry reminders when the warranty card has no responsible users of its own. Each user gets their own task.">
                            <field name="warranty_service_alert_user_ids" widget="many2many_tags"/>
                        </setting>
                        <setting id="warranty_timezone" string="Warranty Timezone"
                                 help="The timezone used to decide when free services are due or expired and to turn delivery, invoice posting and installation times into warranty start dates. If empty, the company's timezone is used, otherwise UTC.">
                            <field name="warranty_timezone"/>
                        </setting>
                    </block>
                    <block title="Warranty Card PDF Download Approval" name="warranty_download_approval_settings">
                        <setting id="warranty_download_approval_required" string="Require PDF Download Approval"
                                 help="If enabled, after the free downloads each warranty card PDF download needs an approved request. If disabled, the PDF can be downloaded at any time.">
                            <field name="warranty_download_approval_required"/>
                        </setting>
                        <setting id="warranty_free_download_count" string="Free Download Count"
                                 invisible="not warranty_download_approval_required"
                                 help="How many times each warranty card PDF can be downloaded without approval (at least 1). The PDF created when the card is confirmed is not counted. Used only when download approval is required.">
                            <field name="warranty_free_download_count"/>
                        </setting>
                        <setting id="warranty_download_approver_ids" string="Download Approval Responsible Users"
                                 invisible="not warranty_download_approval_required"
                                 help="Users who approve or reject the warranty card PDF download requests. A user never approves their own request.">
                            <field name="warranty_download_approver_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                    <block title="Warranty Card Print" name="warranty_card_print_settings">
                        <setting id="warranty_card_hotline" string="Warranty Card Hot Line"
                                 help="The hot line printed on the warranty card. If empty, the company phone is used.">
                            <field name="warranty_card_hotline"/>
                        </setting>
                        <setting id="warranty_card_return_note" string="Registration Copy Note"
                                 help="Note printed on the Registration Copy, for example how and when to return it.">
                            <field name="warranty_card_return_note"/>
                        </setting>
                        <setting id="warranty_card_valid_note" string="Warranty Validity Note"
                                 help="Validity note printed in red on the Registration Copy.">
                            <field name="warranty_card_valid_note"/>
                        </setting>
                        <setting id="warranty_card_terms" string="Warranty Terms and Conditions"
                                 help="The warranty terms and conditions printed on the back of the warranty card.">
                            <field name="warranty_card_terms"/>
                        </setting>
                    </block>
                    <block title="Controlled Warranty Actions" name="warranty_controlled_actions">
                        <setting id="warranty_exception_approver_ids" string="Warranty Exception Approvers"
                                 help="Users who approve or reject warranty change requests: suspension, cancellation, correction, relocation, transfer and extension. A user never decides their own request.">
                            <field name="warranty_exception_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting id="warranty_exception_evidence_required"
                                 help="A warranty suspension request needs an attached document or photo.">
                            <field name="warranty_exception_evidence_required"/>
                        </setting>
                        <setting id="warranty_relocation_allowed"
                                 help="Warranty units can be moved to another site of the same customer, with approval.">
                            <field name="warranty_relocation_allowed"/>
                        </setting>
                        <setting id="warranty_transfer_allowed"
                                 help="A warranty card can be transferred to another customer, with approval.">
                            <field name="warranty_transfer_allowed"/>
                        </setting>
                        <setting id="warranty_extension_max_days" string="Maximum Warranty Extension (Days)"
                                 help="The longest controlled warranty extension in days. 0 means no maximum.">
                            <field name="warranty_extension_max_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_warranty_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'warranty_management', 'bin_size': False}</field>
    </record>
</odoo>
