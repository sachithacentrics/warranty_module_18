<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_card_view_list" model="ir.ui.view">
        <field name="name">warranty.card.list</field>
        <field name="model">warranty.card</field>
        <field name="arch" type="xml">
            <list string="Warranty Cards" create="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id" optional="show"/>
                <field name="unit_serial_numbers" optional="show"/>
                <field name="sale_order_id"/>
                <field name="card_grouping_mode" optional="hide"/>
                <field name="start_criterion" optional="show"/>
                <field name="warranty_start_date"/>
                <field name="warranty_end_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'pending_installation')"
                       decoration-warning="state == 'ready'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state in ('suspended', 'cancelled')"
                       decoration-muted="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="warranty_card_view_form" model="ir.ui.view">
        <field name="name">warranty.card.form</field>
        <field name="model">warranty.card</field>
        <field name="arch" type="xml">
            <form string="Warranty Card" create="false">
                <header>
                    <button name="action_confirm_warranty" type="object" string="Confirm Warranty"
                            class="btn-primary" invisible="state != 'ready'"/>
                    <button name="action_download_pdf" type="object" string="Download PDF"
                            icon="fa-download" invisible="state not in ('confirmed', 'expired')"/>
                    <button name="action_send_warranty_card" type="object" string="Send to Customer"
                            icon="fa-envelope" invisible="state not in ('confirmed', 'expired')"/>
                    <button name="action_open_date_wizard" type="object"
                            string="Record Start Date Exception"
                            groups="warranty_management.group_warranty_date_correction"
                            invisible="state not in ('draft', 'pending_installation', 'ready') or start_criterion not in ('delivery', 'invoice', 'installation')"/>
                    <button name="action_open_date_wizard" type="object"
                            string="Correct Warranty Dates"
                            groups="warranty_management.group_warranty_date_correction"
                            invisible="state not in ('confirmed', 'suspended', 'expired')"/>
                    <button name="action_open_controlled_action" type="object"
                            string="Request Warranty Change"
                            invisible="state not in ('confirmed', 'suspended', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_installation,ready,confirmed,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_service_entitlements" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                invisible="service_entitlement_count == 0">
                            <field name="service_entitlement_count" widget="statinfo" string="Services"/>
                        </button>
                        <button name="action_view_controlled_actions" type="object"
                                class="oe_stat_button" icon="fa-gavel" invisible="action_count == 0">
                            <field name="action_count" widget="statinfo" string="Controlled Actions"/>
                        </button>
                        <button name="action_view_warranty_history" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="history_count" widget="statinfo" string="History"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not missing_requirements">
                        <strong>Missing confirmation requirements:</strong>
                        <field name="missing_requirements" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="product_id" readonly="state not in ('draft', 'pending_installation', 'ready')"
                                   invisible="not product_id and state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="indoor_serial_id" readonly="state not in ('draft', 'pending_installation', 'ready')"
                                   invisible="not indoor_serial_id and state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="outdoor_serial_id" readonly="state not in ('draft', 'pending_installation', 'ready')"
                                   invisible="not outdoor_serial_id and state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="sale_order_id"/>
                            <field name="pricelist_id"/>
                        </group>
                        <group>
                            <field name="start_criterion"/>
                            <field name="warranty_basis"/>
                            <field name="installation_date" readonly="1"
                                   invisible="start_criterion != 'installation'"/>
                            <field name="warranty_start_date"
                                   readonly="start_criterion != 'custom' or state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="warranty_original_end_date" invisible="not warranty_original_end_date"/>
                            <field name="warranty_end_date"
                                   readonly="start_criterion != 'custom' or state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="expected_start_date"
                                   invisible="state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="expected_end_date"
                                   invisible="state not in ('draft', 'pending_installation', 'ready')"/>
                            <field name="confirmation_status" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Warranty Start Date Source" name="start_date_source">
                        <group>
                            <field name="start_date_source"/>
                            <field name="source_picking_id" invisible="not source_picking_id"/>
                            <field name="source_invoice_id" invisible="not source_invoice_id"/>
                            <field name="source_datetime" invisible="not source_datetime"/>
                            <field name="source_verification" invisible="not source_verification"/>
                            <field name="start_exception_date" invisible="not start_exception_date"/>
                        </group>
                        <group>
                            <field name="start_source_note" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Unit Warranty Numbers" name="unit_warranty_numbers">
                            <field name="unit_warranty_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="unit_number"/>
                                    <field name="sale_order_line_id" optional="hide"/>
                                    <field name="stock_move_line_id" optional="show"/>
                                    <field name="delivery_datetime" optional="show"/>
                                    <field name="source_invoice_id" optional="hide"/>
                                    <field name="source_invoice_posted_at" optional="hide"/>
                                    <field name="serial_ids" widget="many2many_tags"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="usage_limit" optional="hide"/>
                                    <field name="usage_unit" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <!-- UX: hidden when the card has no free services (resolved count 0, no
                             entitlements), whatever the kept company Scope Mode (BA 2026-10-28). -->
                        <page string="Free Services" name="free_services"
                              invisible="not free_services_allowed and not service_entitlement_ids">
                            <field name="free_services_included" invisible="1"/>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not free_service_schedule_note">
                                <field name="free_service_schedule_note" nolabel="1"/>
                            </div>
                            <group>
                                <group>
                                    <field name="free_services_used"/>
                                    <field name="free_services_missed"/>
                                    <field name="free_services_expired"/>
                                    <field name="free_services_cancelled"/>
                                    <field name="free_services_balance"/>
                                </group>
                            </group>
                            <group string="Service Due Monitoring (snapshot)" invisible="not service_monitoring_active">
                                <group>
                                    <field name="service_monitoring_active" invisible="1"/>
                                    <field name="grace_period_days"/>
                                    <field name="auto_expire_services"/>
                                    <field name="carry_forward_allowed"/>
                                </group>
                                <group>
                                    <field name="service_due_alert_days"/>
                                    <field name="early_service_rule" invisible="not early_service_rule"/>
                                    <field name="early_service_days" invisible="early_service_rule != 'days'"/>
                                    <field name="late_service_handling" invisible="not early_service_rule"/>
                                    <field name="service_sequence_required"/>
                                    <field name="expiry_reminder_days"/>
                                    <field name="usage_alert_percentage"/>
                                    <field name="service_alert_user_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <field name="service_entitlement_ids"
                                   readonly="state != 'confirmed' or not free_services_included or schedule_method == 'amc_plan'">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="service_no" readonly="id"/>
                                    <field name="service_type" readonly="id"/>
                                    <field name="due_date" readonly="id" decoration-danger="due_date_conflict"/>
                                    <field name="due_date_conflict"/>
                                    <field name="due_status" widget="badge" optional="show"
                                           decoration-info="due_status == 'upcoming'"
                                           decoration-warning="due_status == 'due'"
                                           decoration-danger="due_status == 'overdue'"/>
                                    <field name="scheduled_date" optional="show"/>
                                    <field name="usage_due" optional="show"
                                            column_invisible="parent.warranty_basis != 'usage'"/>
                                    <field name="usage_unit" optional="show"
                                            column_invisible="parent.warranty_basis != 'usage'"/>
                                    <field name="merge_status" optional="hide"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                                           decoration-warning="state == 'missed'"
                                           decoration-danger="state == 'expired'"/>
                                    <button name="action_open_due_date_wizard" type="object" icon="fa-calendar"
                                            title="Change Due Date" invisible="not id or state != 'draft'"/>
                                </list>
                            </field>
                            <group string="Service Offsets (snapshot)" invisible="schedule_method != 'fixed_offsets'">
                                <field name="service_offset_ids" nolabel="1" colspan="2">
                                    <list>
                                        <field name="service_no"/>
                                        <field name="offset"/>
                                        <field name="offset_unit"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Policy" name="policy">
                            <group>
                                <group>
                                    <field name="policy_source"/>
                                    <field name="policy_id"/>
                                    <field name="card_grouping_mode"/>
                                    <field name="warranty_duration"/>
                                    <field name="warranty_duration_unit"/>
                                    <field name="usage_limit" invisible="warranty_basis != 'usage'"
                                           required="warranty_basis == 'usage'"/>
                                    <field name="usage_unit" invisible="warranty_basis != 'usage'"
                                           required="warranty_basis == 'usage'"/>
                                    <field name="payment_check_required" invisible="1"/>
                                </group>
                                <group>
                                    <field name="free_services_allowed"/>
                                    <field name="free_service_frequency" invisible="not free_services_allowed"/>
                                    <field name="free_service_frequency_unit" invisible="not free_services_allowed"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sales &amp; Deliveries" name="sales_deliveries">
                            <group>
                                <field name="sale_order_line_ids" widget="many2many_tags"/>
                                <field name="delivery_ids" widget="many2many_tags"/>
                                <field name="invoice_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Warranty Date History" name="warranty_date_history"
                              invisible="not date_log_ids">
                            <field name="date_log_ids" readonly="1">
                                <list>
                                    <field name="log_datetime"/>
                                    <field name="event"/>
                                    <field name="user_id"/>
                                    <field name="old_start" optional="show"/>
                                    <field name="old_end" optional="show"/>
                                    <field name="new_start" optional="show"/>
                                    <field name="new_end" optional="show"/>
                                    <field name="start_date_source" optional="hide"/>
                                    <field name="picking_id" optional="hide"/>
                                    <field name="invoice_id" optional="hide"/>
                                    <field name="task_reference" optional="hide"/>
                                    <field name="reason"/>
                                    <field name="attachment_ids" widget="many2many_tags" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Information" name="other_information">
                            <group>
                                <group>
                                    <field name="current_active_serial" invisible="1"/>
                                    <field name="replacement_count"/>
                                </group>
                                <group>
                                    <field name="pdf_attachment_id" groups="base.group_system"/>
                                    <field name="print_count"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_card_view_search" model="ir.ui.view">
        <field name="name">warranty.card.search</field>
        <field name="model">warranty.card</field>
        <field name="arch" type="xml">
            <search string="Warranty Cards">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="unit_warranty_ids" string="Serial Number"
                       filter_domain="[('unit_warranty_ids.serial_ids.name', 'ilike', self)]"/>
                <field name="sale_order_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending_installation" string="Pending Installation"
                        domain="[('state', '=', 'pending_installation')]"/>
                <filter name="filter_ready" string="Ready to Confirm" domain="[('state', '=', 'ready')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_sale_order" string="Sale Order" context="{'group_by': 'sale_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_card" model="ir.actions.act_window">
        <field name="name">Warranty Cards</field>
        <field name="res_model">warranty.card</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="warranty_card_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No warranty cards yet</p>
            <p>Draft warranty cards are created when a Sales Order with warranty-applicable products is confirmed.</p>
        </field>
    </record>
</odoo>
