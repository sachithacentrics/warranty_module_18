<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_coverage_item_view_list" model="ir.ui.view">
        <field name="name">warranty.coverage.item.list</field>
        <field name="model">warranty.coverage.item</field>
        <field name="arch" type="xml">
            <list string="Coverage Items" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_warranty_coverage_item" model="ir.actions.act_window">
        <field name="name">Coverage Items</field>
        <field name="res_model">warranty.coverage.item</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
