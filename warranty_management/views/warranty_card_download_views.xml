<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_card_download_request_view_list" model="ir.ui.view">
        <field name="name">warranty.card.download.request.list</field>
        <field name="model">warranty.card.download.request</field>
        <field name="arch" type="xml">
            <list string="Download Approval Requests" create="0" delete="0">
                <field name="name"/>
                <field name="warranty_card_id"/>
                <field name="partner_id" optional="show"/>
                <field name="requested_by_id"/>
                <field name="request_date"/>
                <field name="download_count_at_request" optional="hide"/>
                <field name="decided_by_id" optional="show"/>
                <field name="decision_date" optional="show"/>
                <field name="download_no" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'to_approve'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'used'"/>
                <field name="can_decide" column_invisible="1"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                        class="btn-link text-success" invisible="not can_decide"/>
                <button name="action_reject" type="object" string="Reject" icon="fa-times"
                        class="btn-link text-danger" invisible="not can_decide"/>
            </list>
        </field>
    </record>

    <record id="warranty_card_download_request_view_form" model="ir.ui.view">
        <field name="name">warranty.card.download.request.form</field>
        <field name="model">warranty.card.download.request</field>
        <field name="arch" type="xml">
            <form string="Download Approval Request" create="0" delete="0">
                <header>
                    <field name="can_decide" invisible="1"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not can_decide"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="not can_decide"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,approved,used"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warranty_card_id"/>
                            <field name="partner_id"/>
                            <field name="requested_by_id"/>
                            <field name="request_date"/>
                            <field name="download_count_at_request"/>
                        </group>
                        <group>
                            <field name="decided_by_id"/>
                            <field name="decision_date"/>
                            <field name="download_log_id" invisible="not download_log_id"/>
                            <field name="download_no" invisible="not download_log_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="decision_note" readonly="not can_decide"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_card_download_request_view_search" model="ir.ui.view">
        <field name="name">warranty.card.download.request.search</field>
        <field name="model">warranty.card.download.request</field>
        <field name="arch" type="xml">
            <search string="Download Approval Requests">
                <field name="name"/>
                <field name="warranty_card_id"/>
                <field name="requested_by_id"/>
                <filter name="filter_to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="filter_used" string="Used" domain="[('state', '=', 'used')]"/>
                <separator/>
                <filter name="filter_mine" string="My Requests" domain="[('requested_by_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_card" string="Warranty Card" context="{'group_by': 'warranty_card_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_warranty_card_download_request" model="ir.actions.act_window">
        <field name="name">Download Approval Requests</field>
        <field name="res_model">warranty.card.download.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="warranty_card_download_request_view_search"/>
        <field name="context">{'search_default_filter_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No download approval requests</p>
            <p>A request is created when a warranty card PDF is downloaded again after the free downloads.</p>
        </field>
    </record>

    <record id="warranty_card_download_request_wizard_view_form" model="ir.ui.view">
        <field name="name">warranty.card.download.request.wizard.form</field>
        <field name="model">warranty.card.download.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Download Approval">
                <p>The free downloads of this warranty card PDF are used. Each further download needs one approval.</p>
                <group>
                    <field name="warranty_card_id"/>
                    <field name="download_count"/>
                </group>
                <field name="reason" placeholder="Why is another copy of the warranty card PDF needed?"/>
                <footer>
                    <button name="action_submit" type="object" string="Submit Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
