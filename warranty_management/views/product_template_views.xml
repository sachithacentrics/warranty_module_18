<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_warranty" model="ir.ui.view">
        <field name="name">product.template.form.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Warranty Configuration" name="warranty_configuration">
                    <group>
                        <group>
                            <field name="warranty_applicable"/>
                            <field name="warranty_policy_applicable" readonly="1"
                                   invisible="not warranty_applicable"/>
                            <field name="warranty_policy_id" groups="base.group_system"
                                   options="{'no_create': True}"
                                   invisible="not warranty_applicable"/>
                            <field name="warranty_policy_id" groups="!base.group_system" readonly="1"
                                   invisible="not warranty_applicable"/>
                            <field name="warranty_category_policy_id"
                                   invisible="not warranty_applicable or warranty_policy_id or not warranty_category_policy_id"/>
                            <field name="warranty_applied_policy_id" invisible="1"/>
                            <field name="warranty_start_criterion"
                                   invisible="not warranty_applicable or warranty_policy_applicable"
                                   readonly="warranty_policy_applicable"/>
                            <field name="warranty_policy_start_criterion"
                                   invisible="not warranty_applicable or not warranty_policy_applicable"/>
                            <field name="warranty_basis"
                                   invisible="not warranty_applicable or warranty_policy_applicable"
                                   readonly="warranty_policy_applicable"/>
                            <field name="warranty_policy_basis"
                                   invisible="not warranty_applicable or not warranty_policy_applicable"/>
                            <label for="default_warranty_period"
                                   invisible="not warranty_applicable or warranty_policy_applicable"/>
                            <div class="o_row" invisible="not warranty_applicable or warranty_policy_applicable">
                                <field name="default_warranty_period" readonly="warranty_policy_applicable"/>
                                <field name="default_warranty_period_unit" readonly="warranty_policy_applicable"/>
                            </div>
                            <label for="warranty_policy_period"
                                   invisible="not warranty_applicable or not warranty_policy_applicable"/>
                            <div class="o_row" invisible="not warranty_applicable or not warranty_policy_applicable">
                                <field name="warranty_policy_period"/>
                                <field name="warranty_policy_period_unit"/>
                            </div>
                            <label for="warranty_policy_usage_limit"
                                   invisible="not warranty_applicable or not warranty_policy_applicable or warranty_policy_basis != 'usage'"/>
                            <div class="o_row"
                                 invisible="not warranty_applicable or not warranty_policy_applicable or warranty_policy_basis != 'usage'">
                                <field name="warranty_policy_usage_limit"/>
                                <field name="warranty_policy_usage_unit"/>
                            </div>
                        </group>
                        <group invisible="not warranty_applicable">
                            <field name="warranty_worksheet_template_id" readonly="warranty_policy_applicable"/>
                        </group>
                    </group>
                    <group string="Free Services" name="warranty_free_services" invisible="not warranty_applicable">
                        <group>
                            <field name="default_free_service_count" invisible="warranty_policy_applicable"
                                   readonly="warranty_policy_applicable"/>
                            <field name="warranty_policy_free_service_count" invisible="not warranty_policy_applicable"/>
                            <label for="free_service_frequency" invisible="warranty_policy_applicable"/>
                            <div class="o_row" invisible="warranty_policy_applicable">
                                <field name="free_service_frequency" readonly="warranty_policy_applicable"/>
                                <field name="free_service_frequency_unit" readonly="warranty_policy_applicable"/>
                            </div>
                            <label for="warranty_policy_frequency" invisible="not warranty_policy_applicable"/>
                            <div class="o_row" invisible="not warranty_policy_applicable">
                                <field name="warranty_policy_frequency"/>
                                <field name="warranty_policy_frequency_unit"/>
                            </div>
                            <label for="warranty_policy_service_period" invisible="not warranty_policy_applicable"/>
                            <div class="o_row" invisible="not warranty_policy_applicable">
                                <field name="warranty_policy_service_period"/>
                                <field name="warranty_policy_service_period_unit"/>
                            </div>
                            <field name="default_schedule_method" invisible="warranty_policy_applicable"
                                   readonly="warranty_policy_applicable"/>
                            <field name="warranty_policy_schedule_method" invisible="not warranty_policy_applicable"/>
                            <field name="auto_create_services" invisible="warranty_policy_applicable"
                                   readonly="warranty_policy_applicable"/>
                            <field name="warranty_policy_auto_create" invisible="not warranty_policy_applicable"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_warranty" model="ir.ui.view">
        <field name="name">product.template.search.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="before">
                <field name="warranty_policy_id"/>
                <filter string="Warranty Policy Applicable" name="warranty_policy_applicable"
                        domain="[('warranty_policy_applicable', '=', True)]"/>
                <separator/>
            </filter>
        </field>
    </record>
</odoo>
