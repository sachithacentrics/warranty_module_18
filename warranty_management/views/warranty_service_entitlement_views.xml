<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_service_entitlement_view_list" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.list</field>
        <field name="model">warranty.service.entitlement</field>
        <field name="arch" type="xml">
            <list string="Service Entitlements">
                <field name="name"/>
                <field name="warranty_card_id"/>
                <field name="partner_id"/>
                <field name="service_no"/>
                <field name="service_type" optional="show"/>
                <field name="due_date" decoration-danger="due_date_conflict"/>
                <field name="due_date_conflict" optional="show"/>
                <field name="due_status" widget="badge" optional="show"
                       decoration-info="due_status == 'upcoming'"
                       decoration-warning="due_status == 'due'"
                       decoration-danger="due_status == 'overdue'"/>
                <field name="scheduled_date" optional="show"/>
                <field name="grace_period_end_date" optional="hide"/>
                <field name="warranty_basis" column_invisible="1"/>
                <field name="usage_due" optional="show" invisible="warranty_basis != 'usage'"/>
                <field name="usage_unit" optional="show" invisible="warranty_basis != 'usage'"/>
                <field name="merge_status" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'missed'"
                       decoration-danger="state == 'expired'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="warranty_service_entitlement_view_form" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.form</field>
        <field name="model">warranty.service.entitlement</field>
        <field name="arch" type="xml">
            <form string="Service Entitlement">
                <header>
                    <button name="action_open_schedule_wizard" type="object" string="Schedule"
                            class="btn-primary"
                            invisible="not id or scheduled_date or state not in ('draft', 'pending', 'missed')"/>
                    <button name="action_open_schedule_wizard" type="object" string="Reschedule"
                            invisible="not id or not scheduled_date or state not in ('missed', 'scheduled', 'rescheduled')"/>
                    <button name="action_open_due_date_wizard" type="object" string="Change Due Date"
                            invisible="not id or state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,rescheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not due_date_conflict">
                        The due date is after the warranty end date: manual decision required.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warranty_card_id" readonly="id"/>
                            <field name="partner_id"/>
                            <field name="service_no" readonly="id"/>
                            <field name="service_type" readonly="id"/>
                            <field name="worksheet_template_id"/>
                        </group>
                        <group>
                            <field name="due_date" readonly="id"/>
                            <field name="due_date_conflict"/>
                            <field name="due_status"/>
                            <field name="scheduled_date"/>
                            <field name="reschedule_count" invisible="not reschedule_count"/>
                            <field name="warranty_basis" invisible="1"/>
                            <field name="usage_due" invisible="warranty_basis != 'usage'"/>
                            <field name="usage_unit" invisible="warranty_basis != 'usage'"/>
                            <field name="merge_status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Due Date History" name="due_date_history">
                            <field name="due_date_log_ids">
                                <list>
                                    <field name="change_date"/>
                                    <field name="user_id"/>
                                    <field name="previous_due_date"/>
                                    <field name="new_due_date"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Schedule History" name="schedule_history">
                            <field name="schedule_log_ids">
                                <list>
                                    <field name="change_date"/>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="previous_scheduled_date"/>
                                    <field name="scheduled_date"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Information" name="other_information">
                            <group>
                                <group>
                                    <field name="grace_period_end_date"/>
                                    <field name="alert_date"/>
                                    <field name="expiry_reminder_date"/>
                                    <field name="usage_threshold"/>
                                </group>
                                <group>
                                    <field name="payment_eligibility"/>
                                    <field name="reschedule_count"/>
                                    <field name="due_alert_sent"/>
                                    <field name="expiry_reminder_sent"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="warranty_service_entitlement_view_search" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.search</field>
        <field name="model">warranty.service.entitlement</field>
        <field name="arch" type="xml">
            <search string="Service Entitlements">
                <field name="name"/>
                <field name="warranty_card_id"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_missed" string="Missed" domain="[('state', '=', 'missed')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="filter_scheduled" string="Scheduled / Rescheduled"
                        domain="[('state', 'in', ('scheduled', 'rescheduled'))]"/>
                <filter name="filter_not_scheduled" string="Not Scheduled"
                        domain="[('scheduled_date', '=', False)]"/>
                <separator/>
                <filter name="filter_upcoming" string="Upcoming" domain="[('due_status', '=', 'upcoming')]"/>
                <filter name="filter_due" string="Due" domain="[('due_status', '=', 'due')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('due_status', '=', 'overdue')]"/>
                <separator/>
                <filter name="filter_due_date_conflict" string="Due After Warranty End"
                        domain="[('due_date_conflict', '=', True)]"/>
                <filter name="filter_no_due_date" string="No Due Date"
                        domain="[('due_date', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_card" string="Warranty Card" context="{'group_by': 'warranty_card_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_due_status" string="Due Indicator" context="{'group_by': 'due_status'}"/>
                    <filter name="group_scheduled_month" string="Scheduled Month"
                            context="{'group_by': 'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="warranty_service_entitlement_view_calendar" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.calendar</field>
        <field name="model">warranty.service.entitlement</field>
        <field name="arch" type="xml">
            <calendar string="Free Service Calendar" date_start="scheduled_date" color="state"
                      mode="month" quick_create="0" create="0" event_open_popup="0">
                <field name="partner_id"/>
                <field name="warranty_card_id"/>
                <field name="service_no"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="action_warranty_service_entitlement_calendar" model="ir.actions.act_window">
        <field name="name">Free Service Calendar</field>
        <field name="res_model">warranty.service.entitlement</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="warranty_service_entitlement_view_calendar"/>
        <field name="search_view_id" ref="warranty_service_entitlement_view_search"/>
        <field name="domain">[('scheduled_date', '!=', False)]</field>
        <field name="context">{'search_default_filter_scheduled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scheduled free services yet</p>
            <p>Use Schedule on a free service to book its service date.</p>
        </field>
    </record>

    <record id="action_warranty_service_entitlement" model="ir.actions.act_window">
        <field name="name">Service Entitlements</field>
        <field name="res_model">warranty.service.entitlement</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="warranty_service_entitlement_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No service entitlements yet</p>
            <p>Draft free service entitlements are created when a warranty card that includes free services is confirmed.</p>
        </field>
    </record>
</odoo>
