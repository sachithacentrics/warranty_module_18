<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- WC/xxxxx; unit warranty numbers WN/xxxxx-xx are derived from the card number -->
        <record id="seq_warranty_card" model="ir.sequence">
            <field name="name">Warranty Card</field>
            <field name="code">warranty.card</field>
            <field name="prefix">WC/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_warranty_card_action" model="ir.sequence">
            <field name="name">Warranty Controlled Action</field>
            <field name="code">warranty.card.action</field>
            <field name="prefix">WCA/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_warranty_card_download_request" model="ir.sequence">
            <field name="name">Warranty Card PDF Download Request</field>
            <field name="code">warranty.card.download.request</field>
            <field name="prefix">WDR/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_warranty_service_entitlement" model="ir.sequence">
            <field name="name">Warranty Service Entitlement</field>
            <field name="code">warranty.service.entitlement</field>
            <field name="prefix">WSE/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
