<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_warranty_monitor_free_services" model="ir.cron">
            <field name="name">Warranty: Monitor Free Service Due Dates</field>
            <field name="model_id" ref="model_warranty_service_entitlement"/>
            <field name="state">code</field>
            <field name="code">model._cron_monitor_free_services()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_warranty_expire" model="ir.cron">
            <field name="name">Warranty: Expire Ended Warranties</field>
            <field name="model_id" ref="model_warranty_card"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_warranties()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
