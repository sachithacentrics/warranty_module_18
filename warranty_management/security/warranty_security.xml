<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Start Date Automation (approved D8 / D9 / Q10): authorized start date exceptions and
         corrections of confirmed warranty dates. Not assigned automatically. -->
    <record id="group_warranty_date_correction" model="res.groups">
        <field name="name">Warranty: Date Correction</field>
        <field name="category_id" ref="base.module_category_usability"/>
        <field name="comment">Records start date exceptions (source event missing or not verifiable) and corrects the dates of confirmed / suspended warranty cards, with a reason and audit history.</field>
    </record>

    <data noupdate="1">
        <record id="warranty_card_action_company_rule" model="ir.rule">
            <field name="name">Warranty Controlled Action: multi-company</field>
            <field name="model_id" ref="model_warranty_card_action"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_history_company_rule" model="ir.rule">
            <field name="name">Warranty History: multi-company</field>
            <field name="model_id" ref="model_warranty_history"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_card_company_rule" model="ir.rule">
            <field name="name">Warranty Card: multi-company</field>
            <field name="model_id" ref="model_warranty_card"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_unit_company_rule" model="ir.rule">
            <field name="name">Unit Warranty Number: multi-company</field>
            <field name="model_id" ref="model_warranty_unit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_policy_company_rule" model="ir.rule">
            <field name="name">Warranty Policy: multi-company</field>
            <field name="model_id" ref="model_warranty_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="warranty_service_entitlement_company_rule" model="ir.rule">
            <field name="name">Service Entitlement: multi-company</field>
            <field name="model_id" ref="model_warranty_service_entitlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_entitlement_date_log_company_rule" model="ir.rule">
            <field name="name">Service Entitlement Due Date History: multi-company</field>
            <field name="model_id" ref="model_warranty_service_entitlement_date_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_entitlement_schedule_log_company_rule" model="ir.rule">
            <field name="name">Free Service Schedule History: multi-company</field>
            <field name="model_id" ref="model_warranty_service_entitlement_schedule_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_card_download_log_company_rule" model="ir.rule">
            <field name="name">Warranty Card PDF Download History: multi-company</field>
            <field name="model_id" ref="model_warranty_card_download_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_card_download_request_company_rule" model="ir.rule">
            <field name="name">Warranty Card PDF Download Request: multi-company</field>
            <field name="model_id" ref="model_warranty_card_download_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_card_download_history_company_rule" model="ir.rule">
            <field name="name">Warranty Card PDF Download History (view): multi-company</field>
            <field name="model_id" ref="model_warranty_card_download_history"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_card_download_ticket_company_rule" model="ir.rule">
            <field name="name">Warranty Card PDF Download Ticket: multi-company</field>
            <field name="model_id" ref="model_warranty_card_download_ticket"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_policy_service_offset_company_rule" model="ir.rule">
            <field name="name">Service Offset: multi-company</field>
            <field name="model_id" ref="model_warranty_policy_service_offset"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="warranty_card_date_log_company_rule" model="ir.rule">
            <field name="name">Warranty Date History: multi-company</field>
            <field name="model_id" ref="model_warranty_card_date_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="warranty_invoice_posting_event_company_rule" model="ir.rule">
            <field name="name">Invoice Posting Event: multi-company</field>
            <field name="model_id" ref="model_warranty_invoice_posting_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
