<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_schedule_wizard_view_form" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.schedule.wizard.form</field>
        <field name="model">warranty.service.entitlement.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Free Service">
                <field name="mode" invisible="1"/>
                <group>
                    <group>
                        <field name="entitlement_id"/>
                        <field name="due_date"/>
                        <field name="grace_period_end_date" invisible="not grace_period_end_date"/>
                        <field name="earliest_service_date" invisible="not earliest_service_date"/>
                        <field name="latest_service_date" invisible="not latest_service_date"/>
                        <field name="current_scheduled_date" invisible="mode != 'reschedule'"/>
                    </group>
                    <group>
                        <field name="scheduled_date" options="{'min_date': 'today'}"/>
                    </group>
                </group>
                <field name="reason" required="mode == 'reschedule'"
                       placeholder="Reason for rescheduling (required) / note"/>
                <separator string="Already Scheduled in this Month"/>
                <field name="month_entitlement_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0" no_open="1">
                        <field name="scheduled_date"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="warranty_card_id"/>
                        <field name="service_no"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Schedule"
                            class="btn-primary" invisible="mode != 'schedule'"/>
                    <button name="action_confirm" type="object" string="Confirm Reschedule"
                            class="btn-primary" invisible="mode != 'reschedule'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
