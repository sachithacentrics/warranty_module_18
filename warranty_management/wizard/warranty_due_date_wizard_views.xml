<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_due_date_wizard_view_form" model="ir.ui.view">
        <field name="name">warranty.service.entitlement.due.date.wizard.form</field>
        <field name="model">warranty.service.entitlement.due.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Due Date">
                <group>
                    <group>
                        <field name="entitlement_id"/>
                        <field name="current_due_date"/>
                        <field name="warranty_end_date"/>
                    </group>
                    <group>
                        <field name="new_due_date"/>
                    </group>
                </group>
                <field name="reason" placeholder="Reason for the manual due date change"/>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
