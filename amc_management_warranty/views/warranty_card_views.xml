<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warranty_card_view_form" model="ir.ui.view">
        <field name="name">warranty.card.view.form.inherit.amc_management_warranty</field>
        <field name="model">warranty.card</field>
        <field name="inherit_id" ref="warranty_management.warranty_card_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_convert_to_amc" type="object" string="Convert to AMC"
                        invisible="state not in ('confirmed', 'expired')"
                        groups="amc_management.amc_management_group_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_amc" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="not amc_count"
                        groups="amc_management.amc_management_group_user">
                    <field name="amc_count" widget="statinfo" string="AMC"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
